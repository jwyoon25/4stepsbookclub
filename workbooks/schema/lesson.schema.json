{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4stepsbookclub.com/schemas/lesson.schema.json",
  "title": "4steps workbook lesson",
  "description": "Tutor-authored content for one lesson, including teacher-version guidance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lessonNumber",
    "title",
    "readingRange",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "Optional editor hint pointing to this schema."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Version of the 4steps workbook content model."
    },
    "lessonNumber": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "$ref": "#/$defs/nonEmptyText",
      "maxLength": 100
    },
    "readingRange": {
      "type": "string",
      "$ref": "#/$defs/nonEmptyText",
      "maxLength": 80,
      "description": "Human-readable chapter or page range."
    },
    "framingNote": {
      "type": "string",
      "$ref": "#/$defs/nonEmptyText",
      "maxLength": 400
    },
    "studentInstructions": {
      "type": "string",
      "$ref": "#/$defs/nonEmptyText",
      "maxLength": 400
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readingComprehension",
        "criticalThinkingAndAnalysis",
        "paragraphWriting",
        "vocabulary"
      ],
      "properties": {
        "readingComprehension": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comprehensionQuestion"
          }
        },
        "criticalThinkingAndAnalysis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/analysisQuestion"
          }
        },
        "paragraphWriting": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/writingPrompt"
          }
        },
        "vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vocabularyEntry"
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "comprehensionQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 700
        },
        "quotation": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 700
        },
        "responseSpace": {
          "$ref": "#/$defs/responseSpace",
          "default": {
            "mode": "short-answer"
          },
          "description": "Omit to use the Short answer (3-line) default."
        },
        "responseGuidance": {
          "$ref": "#/$defs/responseGuidance"
        },
        "teacherGuidance": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 1200
        }
      }
    },
    "analysisQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 700
        },
        "quotation": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 700
        },
        "responseSpace": {
          "$ref": "#/$defs/responseSpace",
          "default": {
            "mode": "short-paragraph"
          },
          "description": "Omit to use the Short paragraph (6-line) default."
        },
        "responseGuidance": {
          "$ref": "#/$defs/responseGuidance"
        },
        "teacherGuidance": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 1200
        }
      }
    },
    "writingPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 700
        },
        "hints": {
          "type": "array",
          "description": "Deprecated version 1 input. The loader migrates these items into responseGuidance; new editors must not write this field.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "responseSpace": {
          "$ref": "#/$defs/responseSpace",
          "default": {
            "mode": "full-page"
          }
        },
        "responseGuidance": {
          "$ref": "#/$defs/responseGuidance"
        },
        "exampleStructureOrRubric": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 1200
        },
        "teacherGuidance": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 1200
        }
      }
    },
    "responseGuidance": {
      "type": "array",
      "description": "Optional tutor-authored response guidance or requirements shown unchanged in both student and teacher editions.",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "$ref": "#/$defs/nonEmptyText",
        "maxLength": 180
      }
    },
    "responseSpace": {
      "description": "Tutor-selected response space. Preset-to-line mappings are renderer-owned.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "short-answer",
                "short-paragraph",
                "extended-answer",
                "full-page"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "pages"
          ],
          "properties": {
            "mode": {
              "const": "multiple-pages"
            },
            "pages": {
              "type": "integer",
              "minimum": 2,
              "description": "Total number of full response pages."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "lines"
          ],
          "properties": {
            "mode": {
              "const": "custom-lines"
            },
            "lines": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "vocabularyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "koreanMeaning",
        "definition",
        "bookExcerpt",
        "excerptContext"
      ],
      "properties": {
        "term": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 60
        },
        "koreanMeaning": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 100
        },
        "definition": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 600
        },
        "bookExcerpt": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 600
        },
        "excerptContext": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 700,
          "description": "What is happening in the story around the excerpt; not a word-usage note."
        },
        "chapterReference": {
          "type": "string",
          "$ref": "#/$defs/nonEmptyText",
          "maxLength": 80
        }
      }
    }
  }
}
