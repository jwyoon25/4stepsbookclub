      .image-modal { position: fixed; inset: 0; z-index: 3000; display: none; align-items: center; justify-content: center; padding: 10px; background: rgba(8, 27, 23, 0.88); backdrop-filter: blur(9px); }
      .image-modal.open { display: flex; }
      .modal-dialog { position: relative; width: min(1080px, 100%); max-height: calc(100dvh - 20px); overflow: auto; padding: 16px; border-radius: 19px; background: var(--canvas); box-shadow: 0 30px 90px rgba(0, 0, 0, 0.35); }
