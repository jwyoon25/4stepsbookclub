      .swipe-hint { display: flex; align-items: center; gap: 8px; margin-top: 18px; color: var(--muted); font-size: 11px; }
      .swipe-hint::before { content: "←"; color: var(--coral); }

      .class-section { overflow: hidden; background: var(--ink); color: var(--white); }
