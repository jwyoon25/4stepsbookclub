      .modal-eyebrow { color: var(--coral-dark); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; }
      .modal-caption { margin-top: 4px; color: var(--ink); font-size: 13px; font-weight: 700; }
      .modal-close, .modal-zoom { position: absolute; top: 13px; z-index: 2; height: 40px; border: 1px solid var(--line); background: white; cursor: pointer; }
      .modal-close { right: 13px; width: 40px; display: grid; place-items: center; border-radius: 50%; color: var(--ink); }
      .modal-zoom { right: 60px; padding: 0 11px; border-radius: 999px; color: var(--ink); font-size: 10px; font-weight: 700; }
      .modal-stage { position: relative; min-height: 310px; max-height: 70dvh; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 13px; background: #e8eee8; touch-action: pan-y; }
      .modal-stage.zoomed { align-items: flex-start; justify-content: flex-start; overflow: auto; touch-action: pan-x pan-y pinch-zoom; cursor: zoom-out; }
      .modal-image { width: auto; max-width: 100%; max-height: 68dvh; object-fit: contain; }
      .modal-stage.zoomed .modal-image { width: min(900px, 180vw); max-width: none; max-height: none; }
      .modal-nav { position: absolute; top: 50%; z-index: 2; width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid rgba(23, 52, 47, 0.15); border-radius: 50%; background: rgba(255, 255, 255, 0.92); color: var(--ink); cursor: pointer; transform: translateY(-50%); box-shadow: var(--shadow-sm); }
      .modal-nav:disabled { opacity: 0.3; cursor: default; }
      .modal-nav.prev { left: 8px; }
      .modal-nav.next { right: 8px; }
      .modal-stage.zoomed .modal-nav { display: none; }
      .modal-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 2px 7px; color: var(--muted); font-size: 10px; }
      .modal-counter { color: var(--ink); font-weight: 700; }
      .modal-thumbs { display: flex; gap: 7px; overflow-x: auto; padding: 2px 2px 5px; }
      .modal-thumb { flex: 0 0 48px; width: 48px; height: 64px; padding: 3px; border: 1px solid var(--line); border-radius: 7px; background: white; cursor: pointer; }
      .modal-thumb[aria-current="true"] { border-color: var(--coral); box-shadow: 0 0 0 2px rgba(239, 107, 74, 0.18); }
      .modal-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }

      .toast { position: fixed; left: 50%; bottom: calc(84px + env(safe-area-inset-bottom)); z-index: 4000; width: max-content; max-width: calc(100% - 30px); padding: 12px 17px; border-radius: 999px; background: var(--butter); color: var(--ink); font-size: 12px; font-weight: 700; text-align: center; opacity: 0; transform: translate(-50%, 20px); pointer-events: none; transition: 200ms ease; box-shadow: var(--shadow-lg); }
      .toast.show { opacity: 1; transform: translate(-50%, 0); }

      @media (min-width: 600px) {
        .hero-actions { display: flex; flex-wrap: wrap; }
        .hero-actions .button { width: auto; }
        .intro-grid { grid-template-columns: repeat(2, 1fr); }
        .intro-card.primary { grid-column: 1 / -1; }
        .faculty-proof { grid-template-columns: repeat(3, 1fr); }
        .proof-item { grid-template-columns: 1fr; align-content: start; border-right: 1px solid rgba(255, 255, 255, 0.23); border-bottom: 0; }
        .proof-item:last-child { border-right: 0; }
        .management-grid { grid-template-columns: repeat(3, 1fr); }
        .form-grid { grid-template-columns: repeat(2, 1fr); }
        .field.full { grid-column: 1 / -1; }
      }

      @media (min-width: 760px) {
        .container { width: min(var(--container), calc(100% - 64px)); }
        .section { padding: 112px 0; }
        .section-heading { margin-bottom: 52px; }
        .hero { padding: 78px 0 50px; }
        .hero-grid { grid-template-columns: minmax(0, 1.12fr) minmax(330px, .88fr); align-items: center; gap: 30px; }
        .hero-art { width: 100%; }
        .feedback-note { right: -5%; }
        .trust-strip { margin-top: 58px; }
        .trust-item { padding: 6px 24px; }
        .trust-item strong { font-size: 25px; }
        .trust-item span { font-size: 12px; }
        .intro-grid { grid-template-columns: 1.2fr .8fr .8fr; }
        .intro-card.primary { grid-column: auto; grid-row: span 2; min-height: 500px; }
        .method-header-row { flex-direction: row; align-items: flex-end; justify-content: space-between; }
        .method-header-row .section-heading { margin-bottom: 0; }
        .method-track { display: grid; grid-template-columns: repeat(2, 1fr); margin-right: 0; padding-right: 0; overflow: visible; }
        .method-card { min-width: 0; }
        .swipe-hint { display: none; }
        .gallery-stage { min-height: 570px; }
        .gallery-main { max-height: 548px; }
        .weekly-flow { display: grid; grid-template-columns: repeat(5, 1fr); overflow: visible; }
        .week-card { min-width: 0; }
        .level-hero { grid-template-columns: 1fr auto; align-items: end; }
        .assessment-grid { grid-template-columns: repeat(4, 1fr); }
        .assessment-card { min-height: 220px; }
        .placement-path { display: grid; grid-template-columns: 180px 1fr; align-items: center; gap: 24px; }
        .path-steps { grid-template-columns: repeat(3, 1fr); margin-top: 0; }
        .path-step { grid-template-columns: 37px 1fr; }
        .path-step:not(:last-child)::after { left: auto; right: -6px; top: 50%; bottom: auto; width: 20px; height: 1px; }
        .info-grid { grid-template-columns: minmax(0, 1.45fr) minmax(270px, .55fr); align-items: start; }
        .consult-grid { grid-template-columns: minmax(0, .8fr) minmax(480px, 1.2fr); align-items: start; }
        .consult-form { padding: 32px; }
        .footer-grid { grid-template-columns: 1fr auto; }
        .footer-links { grid-template-columns: repeat(3, auto); }
        .business-info { grid-column: 1 / -1; }
      }

      @media (min-width: 980px) {
        html { scroll-padding-top: 82px; }
        body { padding-bottom: 0; }
        .header-inner { min-height: 82px; }
        .brand-logo { width: 190px; }
        .menu-toggle, .nav-backdrop, .nav-label { display: none; }
        .site-nav { position: static; width: auto; display: flex; align-items: center; gap: 10px; padding: 0; overflow: visible; background: transparent; transform: none; }
        .nav-links { display: flex; align-items: center; gap: 17px; }
        .nav-links > a:not(.nav-cta) { min-height: auto; border: 0; font-family: var(--font-sans); font-size: 12px; }
        .nav-links > a:not(.nav-cta)::after { display: none; }
        .nav-links > a:not(.nav-cta):hover { color: var(--coral-dark); }
        .nav-cta { width: auto; min-height: 44px; margin: 0 0 0 4px; padding: 10px 16px; font-size: 12px; }
        .nav-socials { gap: 5px; margin: 0; }
        .nav-socials .social-chip { width: 38px; height: 38px; min-height: 38px; justify-content: center; padding: 0; overflow: hidden; border: 0; border-radius: 50%; background: transparent; }
        .nav-socials .social-label { display: none; }
        .nav-socials .brand-icon { display: block; width: 100%; height: 100%; object-fit: cover; }
        .hero { min-height: 720px; display: flex; align-items: center; }
        .hero-grid { grid-template-columns: 1.13fr .87fr; gap: 64px; }
        .intro-card { padding: 34px; }
        .method-track { grid-template-columns: repeat(4, 1fr); gap: 16px; }
        .method-card { min-height: 400px; padding: 28px 24px; }
        .method-card:nth-child(even) { margin-top: 38px; }
        .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .faculty-panel { display: grid; grid-template-columns: 1.2fr .8fr; }
        .faculty-main { padding: 58px 54px; }
        .faculty-proof { grid-template-columns: 1fr; border-top: 0; border-left: 1px solid rgba(255, 255, 255, 0.23); }
        .proof-item { grid-template-columns: 46px 1fr; align-content: center; border-right: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.23); }
        .proof-item:last-child { border-bottom: 0; }
        .management-card { min-height: 330px; padding: 30px; }
        .site-footer { padding-bottom: 42px; }
        .mobile-cta { display: none; }
        .toast { bottom: 28px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="#top" aria-label="4steps Book Club 홈">
          <img class="brand-logo" src="/images/logo-new.svg" alt="4steps Book Club" width="244" height="60" />
        </a>
        <button id="menu-toggle" class="menu-toggle" type="button" aria-label="메뉴 열기" aria-controls="site-nav" aria-expanded="false">
          <i data-lucide="menu" aria-hidden="true"></i>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="주요 메뉴">
          <p class="nav-label">EXPLORE 4STEPS</p>
          <div class="nav-links">
            <a href="#method">4steps 방식</a>
            <a href="#class-content">수업 자료</a>
            <a href="#faculty">강사진</a>
            <a href="#level">레벨 안내</a>
            <a href="#faq">FAQ</a>
            <a href="#notices">공지사항</a>
            <a href="#consulting" class="button button-primary nav-cta">무료 레벨테스트</a>
          </div>
          <div class="nav-socials" aria-label="소셜 채널">
            <a class="social-chip" href="https://m.blog.naver.com/4stepsbookclub" target="_blank" rel="noopener noreferrer" aria-label="네이버 블로그 열기 (새 창)" title="네이버 블로그">
              <img class="brand-icon" src="/images/social/naver-blog.png" width="20" height="20" alt="" />
              <span class="social-label">네이버</span>
            </a>
            <a class="social-chip" href="https://pf.kakao.com/_UxlvxnX" target="_blank" rel="noopener noreferrer" aria-label="카카오톡 채널 열기 (새 창)" title="카카오톡 채널">
              <img class="brand-icon" src="/images/social/kakao-channel.png" width="20" height="20" alt="" />
              <span class="social-label">카카오</span>
            </a>
            <a class="social-chip" href="https://www.instagram.com/4stepsbookclub" target="_blank" rel="noopener noreferrer" aria-label="인스타그램 열기 (새 창)" title="인스타그램">
              <img class="brand-icon" src="/images/social/instagram.webp" width="20" height="20" alt="" />
              <span class="social-label">인스타</span>
            </a>
          </div>
        </nav>
      </div>
    </header>
    <div id="nav-backdrop" class="nav-backdrop" aria-hidden="true"></div>

    <main id="main-content">
      <section id="top" class="hero">
        <div class="container">
          <div class="hero-grid">
            <div class="hero-copy">
              <p class="hero-kicker"><span class="hero-kicker-dot" aria-hidden="true"></span> G1–G9 · ONLINE JUNIOR BOOK CLUB</p>
              <h1 class="hero-title">읽은 책이,<br />아이의 <span class="marker">문장</span>이 되도록.</h1>
              <p class="hero-lead">영어 원서를 깊이 읽고, 근거로 생각하고, 말한 뒤 쓰는 수업.</p>
              <p class="hero-detail">서울대학교에 재학 중이며 원어민급 영어 역량을 갖춘 검증된 강사진과 함께하는 4인 소수 관리형 프로그램입니다.</p>
              <div class="hero-credential">
                <img class="hero-credential-crest" src="/images/snu-crest.png" width="56" height="58" alt="서울대학교 심볼마크" />
                <span class="hero-credential-copy">
                  <small>4STEPS FACULTY</small>
                  <strong>서울대학교 재학 강사진</strong>
                  <span>원어민급 영어 역량 · 검증된 튜터</span>
                </span>
              </div>
              <div class="hero-actions">
                <a class="button button-primary" href="#consulting">무료 레벨테스트 신청 <i data-lucide="arrow-down-right" aria-hidden="true"></i></a>
                <a class="button button-outline" href="#class-content">실제 수업 자료 보기</a>
              </div>
            </div>

            <div class="hero-art" aria-label="책을 읽고 질문과 문장으로 확장하는 4steps 수업을 표현한 일러스트레이션">
              <div class="reading-card">
                <div class="card-meta"><span>THIS WEEK'S READING</span><span>CH. 01–12</span></div>
                <p class="card-book">The Maze<br />Runner</p>
                <p class="card-question">Think beyond the plot.</p>
                <div class="notebook-lines" aria-hidden="true"><span></span><span></span><span></span></div>
                <p class="note-script">“What makes a leader?”</p>
              </div>
              <div class="step-tabs" aria-hidden="true"><span>READ</span><span>THINK</span><span>SPEAK</span><span>WRITE</span></div>
              <div class="feedback-note"><b>TEACHER'S NOTE</b><span>좋은 생각이에요.<br />본문 속 근거를 더해 볼까요?</span></div>
            </div>
          </div>

          <div class="trust-strip" aria-label="프로그램 핵심 정보">
            <div class="trust-item"><strong>4 : 1</strong><span>최대 4명<br />소그룹</span></div>
            <div class="trust-item"><strong>G1–G9</strong><span>주니어<br />학습 범위</span></div>
            <div class="trust-item"><strong>4 steps</strong><span>읽기에서<br />글쓰기까지</span></div>
          </div>
        </div>
      </section>

      <section id="about" class="section intro">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">Why 4steps</p>
            <h2 class="section-title">책을 덮은 뒤에도<br />생각이 남는 수업</h2>
            <p class="section-copy">좋은 책을 고르는 것만큼, 읽은 뒤 무엇을 묻고 어떻게 표현하게 하는지가 중요합니다.</p>
          </div>
          <div class="intro-grid">
            <article class="intro-card primary">
              <p>OUR POINT OF VIEW</p>
              <blockquote>“책을 읽었다”에서 끝나지 않고,<br /><span class="scribble">아이의 생각이 말과 글로 보이게</span> 합니다.</blockquote>
            </article>
            <article class="intro-card" data-number="1">
              <span class="intro-icon"><i data-lucide="scan-text" aria-hidden="true"></i></span>
              <h3>수업 목표가 보이게</h3>
              <p>자체 워크북으로 매주 읽기, 어휘, 토론, 글쓰기의 연결을 확인합니다.</p>
            </article>
            <article class="intro-card" data-number="2">
              <span class="intro-icon"><i data-lucide="messages-square" aria-hidden="true"></i></span>
              <h3>모든 아이가 말하게</h3>
              <p>최대 4명의 소그룹 안에서 한 명도 생각을 숨기지 않도록 질문합니다.</p>
            </article>
            <article class="intro-card" data-number="3">
              <span class="intro-icon"><i data-lucide="pen-line" aria-hidden="true"></i></span>
              <h3>피드백이 다음 글로</h3>
              <p>문장을 고쳐 주는 데 그치지 않고 다음 글에서 스스로 개선할 지점을 알려 줍니다.</p>
            </article>
            <article class="intro-card" data-number="4">
              <span class="intro-icon"><i data-lucide="route" aria-hidden="true"></i></span>
              <h3>한 권이 하나의 과정으로</h3>
              <p>읽기부터 에세이까지 흩어지지 않는 하나의 학습 경험으로 설계합니다.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="method" class="section method">
        <div class="container">
          <div class="method-header-row">
            <div class="section-heading">
              <p class="section-kicker">The 4steps Method</p>
              <h2 class="section-title">네 번의 움직임으로<br />한 권을 내 것으로</h2>
            </div>
            <p class="method-note">각 단계는 따로 놀지 않습니다. 읽으며 발견한 질문이 토론을 지나 한 편의 글로 이어집니다.</p>
          </div>
          <div class="method-track" aria-label="4steps 학습 과정">
            {methodSteps.map((step) => (
              <article class="method-card" style={`--step:${step.color};--tint:${step.tint};`}>
                <span class="method-number">{step.number}</span>
                <p class="method-verb">{step.verb}</p>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
                <small>{step.note}</small>
              </article>
            ))}
          </div>
          <p class="swipe-hint">옆으로 넘겨 4단계를 확인하세요</p>
        </div>
      </section>

      <section id="class-content" class="section class-section">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">Inside the Class</p>
            <h2 class="section-title">설명보다 먼저,<br />실제 수업을 보여드립니다</h2>
            <p class="section-copy">작은 글씨도 휴대폰에서 확인할 수 있도록 페이지를 선택하고 크게 볼 수 있습니다.</p>
          </div>

          <div class="gallery-grid">
            {classContentGalleries.map((gallery) => (
              <article class="gallery-card" data-gallery={gallery.id}>
                <div class="gallery-stage-wrap">
                  <button class="gallery-stage" type="button" data-gallery-open aria-label={`${gallery.label} 첫 페이지 크게 보기`}>
                    <img class="gallery-main" data-gallery-main src={gallery.images[0].full} alt={gallery.images[0].alt} loading="lazy" />
                    <span class="zoom-label"><i data-lucide="maximize-2" aria-hidden="true"></i> 크게 보기</span>
                  </button>
                  <div class="gallery-bar">
                    <span data-gallery-caption>{gallery.images[0].caption}</span>
                    <span class="gallery-counter" data-gallery-counter>01 / {String(gallery.images.length).padStart(2, "0")}</span>
                  </div>
                  <div class="gallery-thumbs" role="group" aria-label={`${gallery.label} 페이지 선택`}>
                    {gallery.images.map((image, index) => (
                      <button
                        class="gallery-thumb"
                        type="button"
                        data-gallery-thumb
                        data-index={index}
                        data-full={image.full}
                        data-thumb={image.thumb}
                        data-caption={image.caption}
                        data-alt={image.alt}
                        aria-current={index === 0 ? "true" : "false"}
                        aria-label={`${index + 1}페이지 보기`}
                      >
                        <img src={image.thumb} alt="" width="54" height="72" loading="lazy" />
                      </button>
                    ))}
                  </div>
                </div>
                <div class="gallery-copy">
                  <span class="gallery-index">{gallery.index} · {gallery.label}</span>
                  <h3>{gallery.title}</h3>
                  <p>{gallery.description}</p>
                  <div class="gallery-tags" aria-label="학습 요소">
                    {gallery.tags.map((tag) => <span class="gallery-tag">{tag}</span>)}
                  </div>
                  <button class="button gallery-open" type="button" data-gallery-open>전체 {gallery.images.length}페이지 보기 <i data-lucide="arrow-up-right" aria-hidden="true"></i></button>
                </div>
              </article>
            ))}
          </div>

          <section class="weekly-panel" aria-labelledby="weekly-title">
            <div class="weekly-head">
              <p>A WEEK AT 4STEPS</p>
              <h3 id="weekly-title">매주, 이 흐름을 반복합니다</h3>
            </div>
            <ol class="weekly-flow">
              {weeklySteps.map(([number, title, description]) => (
                <li class="week-card"><span>{number}</span><h4>{title}</h4><p>{description}</p></li>
              ))}
            </ol>
          </section>
        </div>
      </section>

      <section id="faculty" class="section faculty-section">
        <div class="container">
          <div class="faculty-panel">
            <div class="faculty-main">
              <p class="section-kicker">Verified Faculty</p>
              <h2>아이의 영어를 맡기는 일,<br />선생님의 기준부터 분명하게</h2>
              <p>서울대학교 재학 여부와 원어민급 영어 역량, 실제 수업 역량을 함께 확인해 강사진을 선별합니다.</p>
            </div>
            <div class="faculty-proof" aria-label="강사진 선별 기준">
              <article class="proof-item"><span class="proof-number">01</span><div><h3>서울대학교 재학 확인</h3><p>강사진의 재학 여부를 기준에 따라 확인합니다.</p></div></article>
              <article class="proof-item"><span class="proof-number">02</span><div><h3>원어민급 영어 역량</h3><p>영어 원서 수업과 토론을 이끌 언어 역량을 살핍니다.</p></div></article>
              <article class="proof-item"><span class="proof-number">03</span><div><h3>인터뷰와 수업 시연</h3><p>학생의 생각을 끌어내고 설명하는 실제 수업 역량을 봅니다.</p></div></article>
            </div>
          </div>
        </div>
      </section>

      <section id="level" class="section level-section">
        <div class="container">
          <div class="level-hero">
            <div class="section-heading">
              <p class="section-kicker">Level Placement</p>
              <h2 class="section-title">학년보다 먼저,<br />지금 읽고 쓰는 방식을 봅니다</h2>
              <p class="section-copy">G1–G9 범위 안에서 현재 학년과 학습 배경을 참고하고, 네 가지 언어 활동을 함께 살펴 시작점을 찾습니다.</p>
