      .method-card::after { content: ""; position: absolute; width: 150px; height: 150px; right: -55px; bottom: -50px; border-radius: 50%; background: var(--tint); }
      .method-card:nth-child(even) { margin-top: 24px; }
      .method-number { display: inline-flex; width: 43px; height: 43px; align-items: center; justify-content: center; border-radius: 50%; background: var(--tint); color: var(--step); font-size: 12px; font-weight: 700; }
      .method-verb { margin-top: 45px; color: var(--step); font-size: 12px; font-weight: 700; letter-spacing: 0.16em; }
