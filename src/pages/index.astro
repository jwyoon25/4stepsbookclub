      <div class="modal-dialog">
        <div class="modal-header"><div><p class="modal-eyebrow">INSIDE THE CLASS</p><p id="modal-caption" class="modal-caption">4steps 실제 수업 자료</p></div></div>
        <button id="modal-zoom" class="modal-zoom" type="button" aria-pressed="false">확대</button>
        <button id="modal-close" class="modal-close" type="button" aria-label="이미지 닫기"><i data-lucide="x" aria-hidden="true"></i></button>
        <div id="modal-stage" class="modal-stage">
          <button id="modal-prev" class="modal-nav prev" type="button" aria-label="이전 페이지"><i data-lucide="chevron-left" aria-hidden="true"></i></button>
          <img id="modal-image" class="modal-image" src="/images/class-content/workbook/workbook-01.png" alt="4steps 실제 수업 자료" />
          <button id="modal-next" class="modal-nav next" type="button" aria-label="다음 페이지"><i data-lucide="chevron-right" aria-hidden="true"></i></button>
        </div>
        <div class="modal-meta"><span id="modal-page-caption">페이지를 선택하세요.</span><span id="modal-counter" class="modal-counter">01 / 01</span></div>
        <div id="modal-thumbs" class="modal-thumbs" role="group" aria-label="갤러리 페이지 선택"></div>
