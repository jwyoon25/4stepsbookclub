    <div class="modal-dialog">
     <button id="modal-close" data-template-id="modal-close-button" class="canva-button modal-close" type="button" aria-label="이미지 닫기" style="background: rgba(8, 28, 44, 0.9); color: rgb(255, 255, 255);"> <i data-lucide="x"></i> </button> <img data-template-id="modal-feedback-image" data-modal-image="feedback-example-image" class="canva-image modal-image hidden" loading="lazy" src="images/feedback-example.png" alt="학생 에세이 세 편에 문장과 구조 피드백이 자세히 표시된 실제 첨삭 예시 확대 이미지"> <img data-template-id="modal-workbook-image" data-modal-image="workbook-sample-image" class="canva-image modal-image hidden" loading="lazy" src="images/workbook-sample.png" alt="Critical Thinking and Analysis 질문과 Mini Essay Writing 과제가 포함된 4STEPS 자체 교재 확대 이미지">
     <p id="modal-caption" data-template-id="modal-caption" class="canva-text modal-caption" style="color: rgb(16, 42, 67); font-weight: 800; font-style: normal;">4STEPS 실제 수업 자료</p>
    </div>
   </div>
   <div id="toast" data-template-id="success-toast" class="canva-banner toast" role="status" aria-live="polite" style="background: rgb(16, 42, 67); color: rgb(255, 255, 255); font-weight: 600; font-style: normal;">상담 내용을 담은 이메일 작성 화면을 열었습니다.</div>
  </div>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();

      const menuButton = document.getElementById("menu-button");
      const navigation = document.getElementById("site-nav");
      const form = document.getElementById("consult-form");
      const submitButton = document.getElementById("submit-button");
      const toast = document.getElementById("toast");
      const modal = document.getElementById("image-modal");
      const modalClose = document.getElementById("modal-close");
      const modalImages = [...modal.querySelectorAll("[data-modal-image]")];
      let lastFocusedElement = null;

      menuButton.addEventListener("click", () => {
        const isOpen = navigation.classList.toggle("open");
        menuButton.setAttribute("aria-expanded", String(isOpen));
      });

      navigation.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", () => {
          navigation.classList.remove("open");
          menuButton.setAttribute("aria-expanded", "false");
        });
      });

      function openImageModal(targetId, trigger) {
        lastFocusedElement = trigger;
        modalImages.forEach((image) => {
          image.classList.toggle("hidden", image.dataset.modalImage !== targetId);
        });
        modal.classList.add("open");
        modal.setAttribute("aria-hidden", "false");
        document.body.classList.add("modal-open");
        modalClose.focus();
      }

      function closeImageModal() {
        modal.classList.remove("open");
        modal.setAttribute("aria-hidden", "true");
        document.body.classList.remove("modal-open");
        modalImages.forEach((image) => image.classList.add("hidden"));
        if (lastFocusedElement) lastFocusedElement.focus();
      }

      document.querySelectorAll("[data-image-target]").forEach((button) => {
        button.addEventListener("click", () => {
          openImageModal(button.dataset.imageTarget, button);
        });
      });

      modalClose.addEventListener("click", closeImageModal);

      modal.addEventListener("click", (event) => {
        if (event.target === modal) closeImageModal();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal.classList.contains("open")) {
          closeImageModal();
        }
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        submitButton.disabled = true;

        const values = new FormData(form);
        const student = String(values.get("student") || "");
        const grade = String(values.get("grade") || "");
        const birthMonth = String(values.get("birthMonth") || "미입력");
        const school = String(values.get("school") || "미입력");
        const region = String(values.get("region") || "미입력");
        const overseasResidence = String(values.get("overseasResidence") || "미입력");

        const subject = encodeURIComponent("[4STEPS 무료 레벨테스트 신청] " + student);
        const body = encodeURIComponent(
          "학생 이름: " + student + "\n" +
          "현재 학년: " + grade + "\n" +
          "출생 연도 및 월: " + birthMonth + "\n" +
          "학교명: " + school + "\n" +
          "거주 지역: " + region + "\n" +
          "해외 거주 기간: " + overseasResidence
        );

        window.open(
          "mailto:4stepsbookclub@gmail.com?subject=" + subject + "&body=" + body,
          "_blank"
        );

        form.reset();
        toast.classList.add("show");
        submitButton.disabled = false;

        window.setTimeout(() => {
          toast.classList.remove("show");
        }, 4000);
      });
    });
  </script>
</body></html>
