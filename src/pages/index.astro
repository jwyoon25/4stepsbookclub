<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="읽은 책이 아이의 문장이 되도록. G1–G9 영어 리딩, 토론, 라이팅을 연결하는 4인 소수 관리형 4steps Book Club." />
    <meta name="theme-color" content="#f7f3ea" />
    <title>4steps Book Club | 읽은 책이 아이의 문장이 되도록</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <style>
      :root {
        --ink: #17342f;
        --ink-soft: #24483f;
        --paper: #f7f3ea;
        --paper-deep: #eee7da;
        --canvas: #fffdf8;
        --white: #ffffff;
        --coral: #ef6b4a;
        --coral-dark: #c84f37;
        --butter: #f2c55c;
        --aqua: #8bc7c3;
        --lilac: #b9abd8;
        --sage: #9dc5a5;
        --text: #263a34;
        --muted: #66766f;
        --line: #dfe4dc;
        --line-dark: rgba(255, 255, 255, 0.16);
        --shadow-sm: 0 10px 32px rgba(23, 52, 47, 0.08);
        --shadow-lg: 0 24px 70px rgba(23, 52, 47, 0.15);
        --radius-sm: 14px;
        --radius-md: 22px;
        --radius-lg: 32px;
        --font-display: "Gowun Batang", Georgia, serif;
        --font-sans: "IBM Plex Sans KR", system-ui, sans-serif;
        --container: 1160px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 76px; overflow-x: clip; }
      body {
        margin: 0;
        min-width: 320px;
        background: var(--canvas);
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.72;
        overflow-x: clip;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      body.modal-open { overflow: hidden; }
      body.menu-open { overscroll-behavior: none; }
      img { display: block; max-width: 100%; }
      svg { display: block; }
      a { color: inherit; text-decoration: none; }
      button, input, select, textarea { font: inherit; }
      button { color: inherit; }
      h1, h2, h3, h4, p, ul, ol, blockquote { margin: 0; }
      ul, ol { padding: 0; }
      ::selection { background: var(--butter); color: var(--ink); }
      :focus-visible { outline: 3px solid var(--butter); outline-offset: 4px; }

      .skip-link {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 5000;
        transform: translateY(-160%);
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--ink);
        color: var(--white);
        font-weight: 700;
      }
      .skip-link:focus { transform: translateY(0); }
      .container { width: min(var(--container), calc(100% - 32px)); margin-inline: auto; }
      .section { position: relative; padding: 88px 0; scroll-margin-top: 74px; }
      .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 16px;
        color: var(--coral-dark);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      .section-kicker::before { content: ""; width: 22px; height: 2px; border-radius: 99px; background: currentColor; }
      .section-heading { max-width: 730px; margin-bottom: 38px; }
      .section-heading.center { margin-inline: auto; text-align: center; }
      .section-heading.center .section-kicker::before { display: none; }
      .section-title {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(31px, 8.5vw, 44px);
        font-weight: 700;
        line-height: 1.34;
        letter-spacing: -0.045em;
        word-break: keep-all;
      }
      .section-copy { margin-top: 18px; color: var(--muted); line-height: 1.8; word-break: keep-all; }
      .button {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 20px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.35;
        cursor: pointer;
        transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
      }
      .button:hover { transform: translateY(-2px); }
      .button-primary { background: var(--coral); color: var(--white); box-shadow: 0 12px 30px rgba(239, 107, 74, 0.25); }
      .button-primary:hover { background: var(--coral-dark); }
      .button-ink { background: var(--ink); color: var(--white); }
      .button-outline { border-color: rgba(23, 52, 47, 0.24); background: rgba(255, 255, 255, 0.5); color: var(--ink); }
      .button-light { border-color: rgba(255, 255, 255, 0.28); background: rgba(255, 255, 255, 0.08); color: var(--white); }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 1200;
        border-bottom: 1px solid rgba(23, 52, 47, 0.09);
        background: rgba(247, 243, 234, 0.97);
      }
      .header-inner { min-height: 70px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      .brand-logo { width: 169px; height: auto; }
      .menu-toggle {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(23, 52, 47, 0.15);
        border-radius: 50%;
        background: var(--canvas);
        cursor: pointer;
      }
      .menu-toggle svg { width: 21px; height: 21px; }
      .nav-backdrop {
        position: fixed;
        inset: 70px 0 0;
        z-index: 1090;
        opacity: 0;
        visibility: hidden;
        background: rgba(14, 36, 31, 0.44);
        transition: opacity 200ms ease, visibility 200ms ease;
      }
      .nav-backdrop.open { opacity: 1; visibility: visible; }
      .site-nav {
        position: fixed;
        top: 70px;
        right: 0;
        bottom: 0;
        z-index: 1100;
        width: min(88vw, 390px);
        padding: 24px 24px calc(28px + env(safe-area-inset-bottom));
        background: var(--paper);
        transform: translateX(105%);
        transition: transform 240ms cubic-bezier(.22,.8,.24,1);
        overflow-y: auto;
      }
      .site-nav.open { transform: translateX(0); }
      .nav-label { margin-bottom: 18px; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: 0.15em; }
      .nav-links { display: grid; }
      .nav-links > a:not(.nav-cta) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 55px;
        border-bottom: 1px solid var(--line);
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 21px;
        font-weight: 700;
      }
      .nav-links > a:not(.nav-cta)::after { content: "↘"; color: var(--coral); font-family: var(--font-sans); font-size: 15px; }
      .nav-cta { width: 100%; margin-top: 22px; }
      .nav-socials { display: flex; gap: 9px; margin-top: 22px; }
      .social-chip {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--canvas);
        color: var(--ink);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
      }
      .brand-icon { width: 20px; height: 20px; flex: 0 0 auto; border-radius: 50%; object-fit: cover; }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 52px 0 36px;
        background: var(--paper);
      }
      .hero::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        right: -130px;
        top: -95px;
        border: 55px solid rgba(139, 199, 195, 0.28);
        border-radius: 50%;
      }
      .hero::after {
        content: "";
        position: absolute;
        left: -80px;
        bottom: 90px;
        width: 160px;
        height: 160px;
        border-radius: 42% 58% 55% 45%;
        background: rgba(242, 197, 92, 0.19);
        transform: rotate(20deg);
      }
      .hero-grid { position: relative; z-index: 1; display: grid; gap: 44px; }
      .hero-copy { position: relative; z-index: 2; }
      .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        padding: 8px 12px;
        border: 1px solid rgba(23, 52, 47, 0.18);
        border-radius: 999px;
        background: rgba(255, 253, 248, 0.66);
        color: var(--ink);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }
      .hero-kicker-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--coral); box-shadow: 0 0 0 4px rgba(239, 107, 74, 0.14); }
      .hero-title {
        max-width: 700px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(43px, 12vw, 72px);
        font-weight: 700;
        line-height: 1.18;
        letter-spacing: -0.06em;
        word-break: keep-all;
      }
      .hero-title .marker { position: relative; display: inline-block; color: var(--coral-dark); }
      .hero-title .marker::after {
        content: "";
        position: absolute;
        left: 0;
        right: -3px;
        bottom: 3px;
        height: 9px;
        z-index: -1;
        border-radius: 999px 30% 999px 30%;
        background: var(--butter);
        transform: rotate(-1deg);
      }
      .hero-lead { max-width: 620px; margin-top: 24px; color: var(--text); font-size: 17px; font-weight: 600; line-height: 1.7; word-break: keep-all; }
      .hero-detail { max-width: 670px; margin-top: 12px; color: var(--muted); font-size: 14px; line-height: 1.75; word-break: keep-all; }
      .hero-credential {
        display: inline-grid;
        grid-template-columns: 56px minmax(0, 1fr);
        align-items: center;
        gap: 12px;
        max-width: 100%;
        margin-top: 20px;
        padding: 10px 15px 10px 10px;
        border: 1px solid rgba(31, 55, 98, 0.2);
        border-radius: 17px;
        background: rgba(255, 253, 248, 0.88);
        box-shadow: 0 12px 30px rgba(23, 52, 47, 0.1);
      }
      .hero-credential-crest {
        width: 56px;
        height: 58px;
        object-fit: contain;
      }
      .hero-credential-copy { display: grid; gap: 2px; min-width: 0; }
      .hero-credential-copy small { color: #1f3762; font-size: 9px; font-weight: 700; letter-spacing: 0.13em; }
      .hero-credential-copy strong { color: var(--ink); font-size: 14px; line-height: 1.45; word-break: keep-all; }
      .hero-credential-copy span { color: var(--muted); font-size: 11px; line-height: 1.45; word-break: keep-all; }
      .hero-actions { display: grid; gap: 10px; margin-top: 28px; }
      .hero-actions .button { width: 100%; }
      .hero-art { position: relative; width: min(100%, 470px); margin-inline: auto; padding: 18px 10px 30px; }
      .hero-art::before {
        content: "";
        position: absolute;
        inset: 1% 4% 6%;
        border-radius: 50%;
        background: var(--aqua);
        opacity: 0.34;
        transform: rotate(-8deg);
      }
      .reading-card {
        position: relative;
        z-index: 2;
        width: 83%;
        margin-left: 7%;
        padding: 23px 22px 26px;
        border: 1px solid rgba(23, 52, 47, 0.15);
        border-radius: 7px 22px 22px 7px;
        background: var(--canvas);
        box-shadow: var(--shadow-lg);
        transform: rotate(-2deg);
      }
      .reading-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 14px;
        bottom: 0;
        width: 1px;
        background: rgba(239, 107, 74, 0.28);
      }
      .card-meta { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; }
      .card-book { margin: 26px 0 16px 12px; font-family: var(--font-display); font-size: 31px; line-height: 1.1; color: var(--ink); }
      .card-question { margin-left: 12px; color: var(--coral-dark); font-size: 12px; font-weight: 700; }
      .notebook-lines { display: grid; gap: 10px; margin: 15px 0 7px 12px; }
      .notebook-lines span { height: 1px; background: #cfd9d1; }
      .notebook-lines span:nth-child(2) { width: 89%; }
      .notebook-lines span:nth-child(3) { width: 72%; }
