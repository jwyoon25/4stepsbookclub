    <div id="toast" class="toast" role="status" aria-live="polite">이메일 앱을 열었습니다. 전송을 완료해 주세요.</div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        window.lucide?.createIcons();

        const body = document.body;
        const menuToggle = document.getElementById("menu-toggle");
        const navigation = document.getElementById("site-nav");
        const navBackdrop = document.getElementById("nav-backdrop");
        const mobileCta = document.getElementById("mobile-cta");
        const heroSection = document.getElementById("top");
        const consultingSection = document.getElementById("consulting");
        const footer = document.querySelector(".site-footer");

        const setMenu = (open) => {
          navigation?.classList.toggle("open", open);
          navBackdrop?.classList.toggle("open", open);
          body.classList.toggle("menu-open", open);
          menuToggle?.setAttribute("aria-expanded", String(open));
          menuToggle?.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
          if (menuToggle) menuToggle.innerHTML = open ? '<i data-lucide="x" aria-hidden="true"></i>' : '<i data-lucide="menu" aria-hidden="true"></i>';
          window.lucide?.createIcons();
        };

        menuToggle?.addEventListener("click", () => setMenu(!navigation?.classList.contains("open")));
        navBackdrop?.addEventListener("click", () => setMenu(false));
        navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));

        const modal = document.getElementById("image-modal");
        const modalClose = document.getElementById("modal-close");
        const modalZoom = document.getElementById("modal-zoom");
        const modalStage = document.getElementById("modal-stage");
        const modalImage = document.getElementById("modal-image");
        const modalCaption = document.getElementById("modal-caption");
        const modalPageCaption = document.getElementById("modal-page-caption");
        const modalCounter = document.getElementById("modal-counter");
        const modalThumbs = document.getElementById("modal-thumbs");
        const modalPrev = document.getElementById("modal-prev");
        const modalNext = document.getElementById("modal-next");
        let activeImages = [];
        let activeIndex = 0;
        let lastFocused = null;
        let touchStartX = 0;

        const galleryItems = (card) => Array.from(card.querySelectorAll("[data-gallery-thumb]")).map((button) => ({
          full: button.dataset.full,
          thumb: button.dataset.thumb,
          caption: button.dataset.caption,
          alt: button.dataset.alt
        }));

        const updateGalleryCard = (card, index) => {
          const items = galleryItems(card);
          const item = items[index];
          if (!item) return;
          const main = card.querySelector("[data-gallery-main]");
          const caption = card.querySelector("[data-gallery-caption]");
          const counter = card.querySelector("[data-gallery-counter]");
          if (main) { main.src = item.full; main.alt = item.alt; }
          if (caption) caption.textContent = item.caption;
          if (counter) counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
          card.querySelectorAll("[data-gallery-thumb]").forEach((thumb, thumbIndex) => thumb.setAttribute("aria-current", String(thumbIndex === index)));
        };

        document.querySelectorAll("[data-gallery]").forEach((card) => {
          card.querySelectorAll("[data-gallery-thumb]").forEach((thumb) => thumb.addEventListener("click", () => updateGalleryCard(card, Number(thumb.dataset.index))));
          card.querySelectorAll("[data-gallery-open]").forEach((button) => button.addEventListener("click", () => {
            const current = Array.from(card.querySelectorAll("[data-gallery-thumb]")).findIndex((thumb) => thumb.getAttribute("aria-current") === "true");
            openModal(galleryItems(card), Math.max(0, current), button);
          }));
        });

        const renderModal = () => {
          const item = activeImages[activeIndex];
          if (!item || !modalImage) return;
          modalImage.src = item.full;
          modalImage.alt = item.alt;
          if (modalCaption) modalCaption.textContent = item.caption;
          if (modalPageCaption) modalPageCaption.textContent = item.caption;
          if (modalCounter) modalCounter.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(activeImages.length).padStart(2, "0")}`;
          if (modalPrev) modalPrev.disabled = activeIndex === 0;
          if (modalNext) modalNext.disabled = activeIndex === activeImages.length - 1;
          modalThumbs?.querySelectorAll(".modal-thumb").forEach((thumb, index) => thumb.setAttribute("aria-current", String(index === activeIndex)));
          setZoom(false);
        };

        const openModal = (items, index, trigger) => {
          activeImages = items;
          activeIndex = index;
          lastFocused = trigger;
          if (modalThumbs) {
            modalThumbs.innerHTML = "";
            items.forEach((item, itemIndex) => {
              const button = document.createElement("button");
              button.type = "button";
              button.className = "modal-thumb";
              button.setAttribute("aria-label", `${itemIndex + 1}페이지 보기`);
              button.innerHTML = `<img src="${item.thumb}" alt="" />`;
              button.addEventListener("click", () => { activeIndex = itemIndex; renderModal(); });
              modalThumbs.appendChild(button);
            });
          }
          modal?.classList.add("open");
          modal?.setAttribute("aria-hidden", "false");
          body.classList.add("modal-open");
          renderModal();
          modalClose?.focus();
        };

        const closeModal = () => {
          modal?.classList.remove("open");
          modal?.setAttribute("aria-hidden", "true");
          body.classList.remove("modal-open");
          setZoom(false);
          lastFocused?.focus();
        };

        const setZoom = (zoomed) => {
          modalStage?.classList.toggle("zoomed", zoomed);
          modalZoom?.setAttribute("aria-pressed", String(zoomed));
          if (modalZoom) modalZoom.textContent = zoomed ? "축소" : "확대";
        };

        modalClose?.addEventListener("click", closeModal);
        modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
        modalZoom?.addEventListener("click", () => setZoom(!modalStage?.classList.contains("zoomed")));
        modalImage?.addEventListener("click", () => setZoom(!modalStage?.classList.contains("zoomed")));
        modalPrev?.addEventListener("click", () => { if (activeIndex > 0) { activeIndex -= 1; renderModal(); } });
        modalNext?.addEventListener("click", () => { if (activeIndex < activeImages.length - 1) { activeIndex += 1; renderModal(); } });
        modalStage?.addEventListener("touchstart", (event) => { touchStartX = event.changedTouches[0].clientX; }, { passive: true });
        modalStage?.addEventListener("touchend", (event) => {
          if (modalStage.classList.contains("zoomed")) return;
          const delta = event.changedTouches[0].clientX - touchStartX;
          if (Math.abs(delta) < 55) return;
          if (delta < 0 && activeIndex < activeImages.length - 1) activeIndex += 1;
          if (delta > 0 && activeIndex > 0) activeIndex -= 1;
          renderModal();
        }, { passive: true });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            if (modal?.classList.contains("open")) closeModal();
            else setMenu(false);
          }
          if (!modal?.classList.contains("open") || modalStage?.classList.contains("zoomed")) return;
          if (event.key === "ArrowLeft" && activeIndex > 0) { activeIndex -= 1; renderModal(); }
          if (event.key === "ArrowRight" && activeIndex < activeImages.length - 1) { activeIndex += 1; renderModal(); }
        });

        const form = document.getElementById("consult-form");
        const toast = document.getElementById("toast");
        form?.addEventListener("submit", (event) => {
          event.preventDefault();
          if (!form.checkValidity()) { form.reportValidity(); return; }
          const data = new FormData(form);
          const values = Object.fromEntries(data.entries());
          const lines = [
            `학생 이름: ${values.student || ""}`,
            `현재 학년: ${values.grade || ""}`,
            `출생 연도 및 월: ${values.birthMonth || "미입력"}`,
            `학교명: ${values.school || "미입력"}`,
            `거주 지역: ${values.region || "미입력"}`,
            `해외 거주 기간: ${values.overseasResidence || "미입력"}`,
            "",
            "상담 시 참고할 내용:",
            values.message || "미입력"
          ];
          const subject = `[무료 레벨테스트 상담] ${values.student}`;
          window.location.href = `mailto:4stepsbookclub@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
          toast?.classList.add("show");
          window.setTimeout(() => toast?.classList.remove("show"), 3600);
        });

        if (mobileCta && heroSection && consultingSection && footer && "IntersectionObserver" in window) {
          const visible = new Set();
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target));
            mobileCta.classList.toggle("hidden", visible.size > 0);
          }, { threshold: 0.08 });
          observer.observe(heroSection);
          observer.observe(consultingSection);
          observer.observe(footer);
        }
      });
    </script>
  </body>
</html>
