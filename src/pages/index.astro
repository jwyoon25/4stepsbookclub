      .faculty-proof { display: grid; border-top: 1px solid rgba(255, 255, 255, 0.23); }
      .proof-item { min-height: 118px; display: grid; grid-template-columns: 46px 1fr; align-items: center; gap: 13px; padding: 22px 25px; border-bottom: 1px solid rgba(255, 255, 255, 0.23); }
      .proof-item:last-child { border-bottom: 0; }
