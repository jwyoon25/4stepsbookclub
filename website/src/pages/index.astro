const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/images/og/og-default.png", Astro.site);

const noticeEntries = sortNotices(await getCollection("notices"));
const noticesPerPage = 8;
const notices = await Promise.all(
  noticeEntries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content
  }))
);
const noticeDateFormatter = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Asia/Seoul",
