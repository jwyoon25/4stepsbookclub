      <section id="notices" class="section notices-section" aria-labelledby="notice-title">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">NOTICES</p>
            <h2 id="notice-title" class="section-title">공지사항</h2>
            <p class="section-copy">새로운 수업 개설과 프로그램 소식을 확인하세요.</p>
          </div>
          {notices.length > 0 ? (
            <>
              <div id="notice-board" class="notice-board" data-notice-board data-page-size={noticesPerPage} aria-label="공지사항 목록">
                {notices.map(({ entry, Content }, index) => (
                  <article class="notice-row" data-notice-row data-notice-index={index}>
                    <a class="notice-row-link" href={`/announcements/${entry.id}`} aria-label={`${entry.data.title} 자세히 보기`}>
                      <div class="notice-row-meta">
                        <span class="notice-row-number">No. {noticeEntries.length - index}</span>
                        <time class="notice-row-date" datetime={entry.data.postedAt.toISOString()}>{noticeDateFormatter.format(entry.data.postedAt)}</time>
                      </div>
                      <h3 class="notice-row-title">{entry.data.title}</h3>
                      <div class="notice-row-description"><Content /></div>
                    </a>
                  </article>
                ))}
              </div>
              <nav class="notice-pagination" data-notice-pagination aria-label="공지사항 페이지 선택">
                {Array.from({ length: Math.ceil(notices.length / noticesPerPage) }, (_, index) => (
                  <button class="notice-page-button" type="button" data-notice-page={index + 1} aria-label={`${index + 1}페이지`} aria-current={index === 0 ? "page" : undefined}>{index + 1}</button>
                ))}
              </nav>
              <a class="notice-more" href="/announcements/">전체 공지 보기 <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
            </>
          ) : (
            <p class="notice-empty">새로운 수업 개설 소식은 이곳에서 안내드립니다.</p>
          )}
        </div>
      </section>

      <section id="consulting" class="section consulting">
        <div class="container consult-grid">
          <div class="consult-copy">
            <p class="section-kicker">Start with 4steps</p>
            <h2>우리 아이에게 맞는<br />첫 번째 step을 찾아보세요</h2>
            <p>간단한 정보를 남기면 상담 신청이 접수되고, 우리 아이에게 맞는 무료 레벨 테스트 안내를 받을 수 있습니다. 카카오톡으로 바로 문의해도 좋습니다.</p>
            <div class="consult-quick">
              <a class="button button-light" href="https://pf.kakao.com/_UxlvxnX" target="_blank" rel="noopener noreferrer"><img class="brand-icon" src="/images/social/kakao-channel.png" width="19" height="19" alt="" /> 카카오톡 상담</a>
              <a class="button button-light" href="mailto:4stepsbookclub@gmail.com"><i data-lucide="mail" aria-hidden="true"></i> 이메일 문의</a>
            </div>
          </div>

          <div id="consult-form" class="consult-form">
            <iframe class="tally-embed" data-tally-src="https://tally.so/embed/ob86yM?alignLeft=1&amp;hideTitle=1&amp;transparentBackground=1" loading="lazy" width="100%" height="560" scrolling="yes" frameborder="0" marginheight="0" marginwidth="0" title="무료 레벨테스트 상담 신청"></iframe>
          </div>
        </div>
      </section>

    </SiteChrome>

    <div id="image-modal" class="image-modal" role="dialog" aria-modal="true" aria-labelledby="modal-caption" aria-hidden="true" inert>
      <div class="modal-dialog">
        <div class="modal-header"><div><p class="modal-eyebrow">INSIDE THE CLASS</p><p id="modal-caption" class="modal-caption">4steps 실제 수업 자료</p></div></div>
        <button id="modal-zoom" class="modal-zoom" type="button" aria-pressed="false">확대</button>
        <button id="modal-close" class="modal-close" type="button" aria-label="이미지 닫기"><i data-lucide="x" aria-hidden="true"></i></button>
        <div id="modal-stage" class="modal-stage">
          <button id="modal-prev" class="modal-nav prev" type="button" aria-label="이전 페이지"><i data-lucide="chevron-left" aria-hidden="true"></i></button>
          <img id="modal-image" class="modal-image" src="/images/class-content/workbook/workbook-01.png" alt="4steps 실제 수업 자료" />
          <button id="modal-next" class="modal-nav next" type="button" aria-label="다음 페이지"><i data-lucide="chevron-right" aria-hidden="true"></i></button>
        </div>
        <div class="modal-meta"><span id="modal-page-caption">페이지를 선택하세요.</span><span id="modal-counter" class="modal-counter">01 / 01</span></div>
        <div id="modal-thumbs" class="modal-thumbs" role="group" aria-label="갤러리 페이지 선택"></div>
      </div>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        window.lucide?.createIcons();

        const alignCompatibilityAnchor = () => {
          if (location.hash !== "#level-system" && location.hash !== "#curriculum") return;
          const target = document.querySelector(location.hash);
          if (target) window.requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
        };
        window.addEventListener("hashchange", alignCompatibilityAnchor);
        const settleCompatibilityAnchor = () => {
          const afterFonts = document.fonts?.ready || Promise.resolve();
          afterFonts.then(() => {
            alignCompatibilityAnchor();
            window.setTimeout(alignCompatibilityAnchor, 350);
            window.setTimeout(alignCompatibilityAnchor, 1000);
          });
        };
        if (document.readyState === "complete") settleCompatibilityAnchor();
        else window.addEventListener("load", settleCompatibilityAnchor, { once: true });

        const body = document.body;
        const menuToggle = document.getElementById("menu-toggle");
        const navigation = document.getElementById("site-nav");
        const navBackdrop = document.getElementById("nav-backdrop");
        const mobileCta = document.getElementById("mobile-cta");
        const siteHeader = document.querySelector(".site-header");
        const pageMain = document.getElementById("main-content");
        const brandHome = document.querySelector(".brand-home");
        const skipLink = document.querySelector(".skip-link");
        const heroSection = document.getElementById("top");
        const consultingSection = document.getElementById("consulting");
        const footer = document.querySelector(".site-footer");
        const desktopNavigation = window.matchMedia("(min-width: 1180px)");
        const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

        const toggleInert = (elements, inert) => {
          elements.filter(Boolean).forEach((element) => element.toggleAttribute("inert", inert));
        };

        const visibleFocusables = (container) => Array.from(container?.querySelectorAll(focusableSelector) || [])
          .filter((element) => !element.closest("[inert]") && element.getClientRects().length > 0);

        const trapTab = (elements, event) => {
          if (event.key !== "Tab" || !elements.length) return;
          const first = elements[0];
          const last = elements[elements.length - 1];
          if (!elements.includes(document.activeElement)) {
            event.preventDefault();
            first.focus();
          } else if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        };

        const menuPageRegions = [pageMain, footer, mobileCta, brandHome, skipLink];
        const modalPageRegions = [siteHeader, pageMain, footer, mobileCta, skipLink];

        const setMenu = (requestedOpen, options = {}) => {
          const open = Boolean(requestedOpen && !desktopNavigation.matches);
          navigation?.classList.toggle("open", open);
          navBackdrop?.classList.toggle("open", open);
          body.classList.toggle("menu-open", open);
          menuToggle?.setAttribute("aria-expanded", String(open));
          menuToggle?.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
          navBackdrop?.setAttribute("aria-hidden", String(!open));
          navigation?.toggleAttribute("inert", !desktopNavigation.matches && !open);
          toggleInert(menuPageRegions, open);

          if (open && options.focus !== false) {
            window.setTimeout(() => navigation?.querySelector("a")?.focus({ preventScroll: true }), 260);
          } else if (!open && options.restoreFocus !== false && navigation?.contains(document.activeElement)) {
            menuToggle?.focus({ preventScroll: true });
          }
        };

        menuToggle?.addEventListener("click", () => setMenu(!navigation?.classList.contains("open")));
        navBackdrop?.addEventListener("click", () => setMenu(false));
        navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false, { restoreFocus: false })));
        const syncNavigation = () => setMenu(false, { restoreFocus: false });
        if (desktopNavigation.addEventListener) desktopNavigation.addEventListener("change", syncNavigation);
        else desktopNavigation.addListener(syncNavigation);
        syncNavigation();

        const noticeBoard = document.querySelector("[data-notice-board]");
        const noticePagination = document.querySelector("[data-notice-pagination]");
        if (noticeBoard && noticePagination) {
          const noticeRows = Array.from(noticeBoard.querySelectorAll("[data-notice-row]"));
          const noticePageButtons = Array.from(noticePagination.querySelectorAll("[data-notice-page]"));
          const noticePageSize = Number(noticeBoard.dataset.pageSize) || 3;
          const noticePageCount = Math.max(1, Math.ceil(noticeRows.length / noticePageSize));

          const renderNoticePage = (requestedPage) => {
            const currentPage = Math.min(Math.max(Number(requestedPage) || 1, 1), noticePageCount);
            noticeRows.forEach((row, index) => {
              row.hidden = Math.floor(index / noticePageSize) + 1 !== currentPage;
            });
            noticePageButtons.forEach((button) => {
              const isCurrent = Number(button.dataset.noticePage) === currentPage;
              if (isCurrent) button.setAttribute("aria-current", "page");
              else button.removeAttribute("aria-current");
            });
          };

          noticePageButtons.forEach((button) => button.addEventListener("click", () => {
            renderNoticePage(button.dataset.noticePage);
          }));
          renderNoticePage(1);
        }

        const modal = document.getElementById("image-modal");
        const modalClose = document.getElementById("modal-close");
        const modalZoom = document.getElementById("modal-zoom");
        const modalStage = document.getElementById("modal-stage");
        const modalImage = document.getElementById("modal-image");
        const modalCaption = document.getElementById("modal-caption");
        const modalPageCaption = document.getElementById("modal-page-caption");
        const modalCounter = document.getElementById("modal-counter");
        const modalThumbs = document.getElementById("modal-thumbs");
        const modalPrev = document.getElementById("modal-prev");
        const modalNext = document.getElementById("modal-next");
        let activeImages = [];
        let activeIndex = 0;
        let lastFocused = null;
        let touchStartX = 0;

        const galleryItems = (card) => Array.from(card.querySelectorAll("[data-gallery-thumb]")).map((button) => ({
          full: button.dataset.full,
          preview: button.dataset.preview,
          thumb: button.dataset.thumb,
          caption: button.dataset.caption,
          alt: button.dataset.alt
        }));

        const updateGalleryCard = (card, index) => {
          const items = galleryItems(card);
          const item = items[index];
          if (!item) return;
          const main = card.querySelector("[data-gallery-main]");
          const caption = card.querySelector("[data-gallery-caption]");
          const counter = card.querySelector("[data-gallery-counter]");
          if (main) { main.src = item.preview || item.full; main.alt = item.alt; }
          if (caption) caption.textContent = item.caption;
          if (counter) counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
          card.querySelectorAll("[data-gallery-thumb]").forEach((thumb, thumbIndex) => thumb.setAttribute("aria-current", String(thumbIndex === index)));
        };

        document.querySelectorAll("[data-gallery]").forEach((card) => {
          card.querySelectorAll("[data-gallery-thumb]").forEach((thumb) => thumb.addEventListener("click", () => updateGalleryCard(card, Number(thumb.dataset.index))));
          card.querySelectorAll("[data-gallery-open]").forEach((button) => button.addEventListener("click", () => {
            const current = Array.from(card.querySelectorAll("[data-gallery-thumb]")).findIndex((thumb) => thumb.getAttribute("aria-current") === "true");
            openModal(galleryItems(card), Math.max(0, current), button);
          }));
        });

        const renderModal = () => {
          const item = activeImages[activeIndex];
          if (!item || !modalImage) return;
          modalImage.src = item.full;
          modalImage.alt = item.alt;
          if (modalCaption) modalCaption.textContent = item.caption;
          if (modalPageCaption) modalPageCaption.textContent = item.caption;
          if (modalCounter) modalCounter.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(activeImages.length).padStart(2, "0")}`;
          if (modalPrev) modalPrev.disabled = activeIndex === 0;
          if (modalNext) modalNext.disabled = activeIndex === activeImages.length - 1;
          modalThumbs?.querySelectorAll(".modal-thumb").forEach((thumb, index) => thumb.setAttribute("aria-current", String(index === activeIndex)));
          setZoom(false);
        };

        const openModal = (items, index, trigger) => {
          setMenu(false, { restoreFocus: false });
          activeImages = items;
          activeIndex = index;
          lastFocused = trigger;
          if (modalThumbs) {
            modalThumbs.innerHTML = "";
            items.forEach((item, itemIndex) => {
              const button = document.createElement("button");
              button.type = "button";
              button.className = "modal-thumb";
              button.setAttribute("aria-label", `${itemIndex + 1}페이지 보기`);
              button.innerHTML = `<img src="${item.thumb}" alt="" />`;
              button.addEventListener("click", () => { activeIndex = itemIndex; renderModal(); });
              modalThumbs.appendChild(button);
            });
          }
          modal?.removeAttribute("inert");
          modal?.classList.add("open");
          modal?.setAttribute("aria-hidden", "false");
          toggleInert(modalPageRegions, true);
          body.classList.add("modal-open");
          renderModal();
          modalClose?.focus();
        };

        const closeModal = () => {
          modal?.classList.remove("open");
          modal?.setAttribute("aria-hidden", "true");
          modal?.setAttribute("inert", "");
          body.classList.remove("modal-open");
          toggleInert(modalPageRegions, false);
          setMenu(false, { restoreFocus: false });
          setZoom(false);
          lastFocused?.focus();
        };

        const setZoom = (zoomed) => {
          modalStage?.classList.toggle("zoomed", zoomed);
          modalZoom?.setAttribute("aria-pressed", String(zoomed));
          if (modalZoom) modalZoom.textContent = zoomed ? "축소" : "확대";
        };

        modalClose?.addEventListener("click", closeModal);
        modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
        modalZoom?.addEventListener("click", () => setZoom(!modalStage?.classList.contains("zoomed")));
        modalImage?.addEventListener("click", () => setZoom(!modalStage?.classList.contains("zoomed")));
        modalPrev?.addEventListener("click", () => { if (activeIndex > 0) { activeIndex -= 1; renderModal(); } });
        modalNext?.addEventListener("click", () => { if (activeIndex < activeImages.length - 1) { activeIndex += 1; renderModal(); } });
        modalStage?.addEventListener("touchstart", (event) => { touchStartX = event.changedTouches[0].clientX; }, { passive: true });
        modalStage?.addEventListener("touchend", (event) => {
          if (modalStage.classList.contains("zoomed")) return;
          const delta = event.changedTouches[0].clientX - touchStartX;
          if (Math.abs(delta) < 55) return;
          if (delta < 0 && activeIndex < activeImages.length - 1) activeIndex += 1;
          if (delta > 0 && activeIndex > 0) activeIndex -= 1;
          renderModal();
        }, { passive: true });

        document.addEventListener("keydown", (event) => {
          if (modal?.classList.contains("open")) {
            if (event.key === "Escape") closeModal();
            if (event.key === "Tab") trapTab(visibleFocusables(modal), event);
            if (!modalStage?.classList.contains("zoomed")) {
              if (event.key === "ArrowLeft" && activeIndex > 0) { activeIndex -= 1; renderModal(); }
              if (event.key === "ArrowRight" && activeIndex < activeImages.length - 1) { activeIndex += 1; renderModal(); }
            }
            return;
          }

          if (navigation?.classList.contains("open")) {
            if (event.key === "Escape") setMenu(false);
            if (event.key === "Tab") trapTab([menuToggle, ...visibleFocusables(navigation)].filter(Boolean), event);
          }
        });

        if (mobileCta && heroSection && consultingSection && footer && "IntersectionObserver" in window) {
          const visible = new Set();
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target));
            mobileCta.classList.toggle("hidden", visible.size > 0);
          }, { threshold: 0.08 });
          observer.observe(heroSection);
          observer.observe(consultingSection);
          observer.observe(footer);
        }
      });
    </script>
    <script is:inline>
      var d = document;
      var w = "https://tally.so/widgets/embed.js";
      var v = function () {
        if (typeof Tally !== "undefined") Tally.loadEmbeds();
        else d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(function (e) { e.src = e.dataset.tallySrc; });
      };
      if (typeof Tally !== "undefined") v();
      else if (d.querySelector('script[src="' + w + '"]') == null) {
        var s = d.createElement("script");
        s.src = w;
        s.onload = v;
        s.onerror = v;
        d.body.appendChild(s);
      }
    </script>
  </body>
</html>
