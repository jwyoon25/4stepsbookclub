    <link rel="icon" type="image/svg+xml" href="/images/logo/logomark-small-dark.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/icons/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/images/icons/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/icons/favicon-192.png" />
    <link rel="shortcut icon" href="/images/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@700&family=IBM+Plex+Sans+KR:wght@400;600;700&display=swap" rel="stylesheet" />
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <style>
      :root {
        --ink: #17342f;
        --ink-soft: #24483f;
        --paper: #f7f3ea;
        --paper-deep: #eee7da;
        --canvas: #fffdf8;
        --white: #ffffff;
        --coral: #ef6b4a;
        --coral-dark: #b84431;
        --butter: #f2c55c;
        --aqua: #8bc7c3;
        --lilac: #b9abd8;
        --sage: #9dc5a5;
        --stage-surface: #dfe8df;
        --text: #263a34;
        --muted: #5f7069;
        --line: #dfe4dc;
        --line-dark: rgba(255, 255, 255, 0.16);
        --shadow-sm: 0 10px 32px rgba(23, 52, 47, 0.08);
        --shadow-lg: 0 24px 70px rgba(23, 52, 47, 0.15);
        --radius-sm: 14px;
        --radius-md: 22px;
        --radius-lg: 32px;
        /* Typography system: serif for ideas, sans for interface copy. */
        --font-display: "Gowun Batang", Georgia, serif;
        --font-sans: "IBM Plex Sans KR", system-ui, sans-serif;
        --weight-regular: 400;
        --weight-semibold: 600;
        --weight-bold: 700;
        --type-hero: clamp(42px, 11.5vw, 72px);
        --type-section: clamp(31px, 8.5vw, 44px);
        --type-heading: 24px;
        --type-body: 16px;
        --type-small: 14px;
        --type-label: 12px;
        --leading-display: 1.34;
        --leading-heading: 1.45;
        --leading-body: 1.75;
        --leading-label: 1.4;
        --tracking-display: -0.045em;
        --tracking-label: 0.12em;
        --container: 1160px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: calc(72px + env(safe-area-inset-top));
        overflow-x: hidden;
        overflow-x: clip;
      }
      body {
        margin: 0;
        min-width: 320px;
        background: var(--canvas);
        color: var(--text);
        font-family: var(--font-sans);
        font-size: var(--type-body);
        line-height: var(--leading-body);
        overflow-x: hidden;
        overflow-x: clip;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      body.modal-open { overflow: hidden; overscroll-behavior: none; }
      body.menu-open { overflow: clip; overscroll-behavior: none; }
      img { display: block; max-width: 100%; }
      svg { display: block; }
      a { color: inherit; text-decoration: none; }
      a, button, summary { touch-action: manipulation; -webkit-tap-highlight-color: rgba(23, 52, 47, 0.1); }
      button, input, select, textarea { font: inherit; }
      button { color: inherit; }
      h1, h2, h3, h4, p, ul, ol, blockquote { margin: 0; }
      ul, ol { padding: 0; }
      ::selection { background: var(--butter); color: var(--ink); }
      :focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; box-shadow: 0 0 0 6px var(--butter); }

      /* Keep the sticky header offset in one place: html scroll-padding-top.
         Applying the same offset here as scroll-margin-top makes every anchor
         stop one header-height too early, leaving the previous section visible. */
      .anchor-target { position: absolute; top: 0; display: block; width: 1px; height: 1px; }
      .button-ink { background: var(--ink); color: var(--white); }
      .button-outline { border-color: rgba(23, 52, 47, 0.24); background: rgba(255, 255, 255, 0.5); color: var(--ink); }
      .button-light { border-color: rgba(255, 255, 255, 0.28); background: rgba(255, 255, 255, 0.08); color: var(--white); }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 44px 0 32px;
        background: var(--paper);
      }
      .hero::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        right: -130px;
        top: -95px;
        border: 55px solid rgba(139, 199, 195, 0.28);
        border-radius: 50%;
      }
      .hero::after {
        content: "";
        position: absolute;
        left: -80px;
        bottom: 90px;
        width: 160px;
        height: 160px;
        border-radius: 42% 58% 55% 45%;
        background: rgba(242, 197, 92, 0.19);
        transform: rotate(20deg);
      }
      .hero-grid { position: relative; z-index: 1; display: grid; gap: 30px; }
      .hero-copy { position: relative; z-index: 2; }
      .hero-title {
        max-width: 700px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: var(--type-hero);
        font-weight: var(--weight-bold);
        line-height: 1.18;
        letter-spacing: var(--tracking-display);
        word-break: keep-all;
      }
      .hero-title .marker { position: relative; display: inline-block; color: var(--coral-dark); }
      .hero-title .marker::after {
        content: "";
        position: absolute;
        left: 0;
        right: -3px;
        bottom: 3px;
        height: 9px;
        z-index: -1;
        border-radius: 999px 30% 999px 30%;
        background: var(--butter);
        transform: rotate(-1deg);
      }
      .hero-lead { max-width: 620px; margin-top: 7px; color: var(--text); font-size: var(--type-body); font-weight: var(--weight-semibold); line-height: 1.68; word-break: keep-all; }
      .hero-detail { max-width: 670px; margin-top: 10px; color: var(--muted); font-size: var(--type-small); line-height: 1.72; word-break: keep-all; }
      .hero-credential {
        position: relative;
        display: inline-grid;
        grid-template-columns: 82px minmax(0, 1fr);
        align-items: center;
        gap: 13px;
        width: min(100%, 340px);
        margin-top: 18px;
        padding: 12px 14px 12px 17px;
        overflow: hidden;
        border: 1px solid rgba(31, 55, 98, 0.25);
        border-radius: 20px;
        background: rgba(255, 253, 248, 0.96);
        box-shadow: 0 16px 36px rgba(23, 52, 47, 0.14);
      }
      .hero-credential-seal {
        width: 80px;
        height: 80px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(31, 55, 98, 0.18);
        border-radius: 50%;
        background: white;
        box-shadow: 0 0 0 5px rgba(31, 55, 98, 0.08);
      }
      .hero-credential-crest {
        width: 70px;
        height: 72px;
        object-fit: contain;
      }
      .hero-credential-copy { display: grid; gap: 3px; min-width: 0; }
      .hero-credential-copy > small { color: #1f3762; font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: 0.1em; }
      .hero-credential-copy > strong { color: var(--ink); font-size: var(--type-body); line-height: 1.4; word-break: keep-all; }
      .hero-credential-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; margin-top: 2px; color: var(--muted); font-size: var(--type-label); line-height: 1.4; word-break: keep-all; }
      .hero-actions { display: grid; gap: 9px; margin-top: 22px; }
      .hero-actions .button { width: 100%; }
      .hero-art { position: relative; width: min(100%, 440px); margin-inline: auto; padding: 10px 8px 26px; }
      .hero-art::before {
        content: "";
        position: absolute;
        inset: 1% 4% 6%;
        border-radius: 50%;
        background: var(--aqua);
        opacity: 0.34;
        transform: rotate(-8deg);
      }
      .reading-card {
        position: relative;
        z-index: 2;
        width: 83%;
        margin-left: 7%;
        padding: 23px 22px 26px;
        border: 1px solid rgba(23, 52, 47, 0.15);
        border-radius: 7px 22px 22px 7px;
        background: var(--canvas);
        box-shadow: var(--shadow-lg);
        transform: rotate(-2deg);
      }
      .reading-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 14px;
        bottom: 0;
        width: 1px;
        background: rgba(239, 107, 74, 0.28);
      }
      .card-meta { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: var(--tracking-label); }
      .card-book { margin: 26px 0 16px 12px; font-family: var(--font-display); font-size: var(--type-heading); line-height: 1.1; color: var(--ink); }
      .card-question { margin-left: 12px; color: var(--coral-dark); font-size: var(--type-label); font-weight: var(--weight-bold); }
      .notebook-lines { display: grid; gap: 10px; margin: 15px 0 7px 12px; }
      .notebook-lines span { height: 1px; background: #cfd9d1; }
      .notebook-lines span:nth-child(2) { width: 89%; }
      .notebook-lines span:nth-child(3) { width: 72%; }
      .note-script { margin: 17px 0 0 12px; color: var(--ink); font-family: var(--font-display); font-size: var(--type-heading); transform: rotate(-1deg); }
      .feedback-note {
        position: absolute;
        right: 0;
        bottom: 1%;
        z-index: 3;
        width: 57%;
        padding: 14px 15px;
        border-radius: 14px 14px 4px 14px;
        background: var(--coral-dark);
        color: var(--white);
        box-shadow: 0 16px 35px rgba(200, 79, 55, 0.24);
        transform: rotate(4deg);
      }
      .feedback-note b { display: block; font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: 0.09em; }
      .feedback-note span { display: block; margin-top: 4px; font-family: var(--font-display); font-size: var(--type-small); line-height: var(--leading-heading); }
      .step-tabs { position: absolute; top: 24%; right: 0; z-index: 4; display: grid; gap: 7px; }
      .step-tabs span { width: 44px; height: 20px; border-radius: 0 7px 7px 0; color: var(--ink); font-size: var(--type-label); font-weight: var(--weight-bold); line-height: 20px; text-align: center; letter-spacing: 0.06em; }
      .step-tabs span:nth-child(1) { background: var(--butter); }
      .step-tabs span:nth-child(2) { background: var(--sage); }
      .step-tabs span:nth-child(3) { background: var(--aqua); }
      .step-tabs span:nth-child(4) { background: var(--lilac); }
      .trust-strip {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 0;
        padding: 16px 0;
        border-top: 1px solid rgba(23, 52, 47, 0.15);
        border-bottom: 1px solid rgba(23, 52, 47, 0.15);
      }
      .trust-item { padding: 0 9px; text-align: center; }
      .trust-item + .trust-item { border-left: 1px solid rgba(23, 52, 47, 0.15); }
      .trust-item strong { display: block; color: var(--ink); font-family: var(--font-display); font-size: var(--type-heading); line-height: 1.2; }
      .trust-item span { display: block; margin-top: 5px; color: var(--muted); font-size: var(--type-label); line-height: var(--leading-label); word-break: keep-all; }

      .intro { background: var(--canvas); }
      .about-story { display: grid; gap: 14px; }
      .about-positioning { padding: 27px 24px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--white); box-shadow: var(--shadow-sm); }
      .about-positioning h3 { color: var(--ink); font-family: var(--font-display); font-size: var(--type-heading); line-height: 1.48; letter-spacing: var(--tracking-display); word-break: keep-all; }
      .about-positioning > p { margin-top: 15px; color: var(--muted); font-size: var(--type-small); line-height: 1.8; word-break: keep-all; }
      .about-quote { margin-top: 24px; padding: 19px 19px 20px; border-left: 3px solid var(--coral); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; background: var(--paper); color: var(--ink); font-family: var(--font-display); font-size: var(--type-heading); font-weight: var(--weight-bold); line-height: var(--leading-body); word-break: keep-all; }
      .problem-panel { padding: 27px 24px; border-radius: var(--radius-md); background: var(--ink); color: var(--white); box-shadow: var(--shadow-lg); }
      .problem-panel h3 { font-family: var(--font-display); font-size: var(--type-heading); line-height: var(--leading-heading); word-break: keep-all; }
      .problem-list { display: grid; gap: 0; margin-top: 19px; list-style: none; }
      .problem-list li { position: relative; padding: 14px 0 14px 28px; border-top: 1px solid rgba(255, 255, 255, 0.14); color: rgba(255, 255, 255, 0.82); font-size: var(--type-small); line-height: 1.65; word-break: keep-all; }
      .problem-list li::before { content: ""; position: absolute; left: 2px; top: 22px; width: 10px; height: 2px; border-radius: 9px; background: var(--butter); }
      .comparison-block { margin-top: 20px; font-family: var(--font-sans); }
      .comparison-card-grid { display: grid; gap: 12px; }
      .comparison-card { padding: 19px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--white); box-shadow: var(--shadow-sm); }
      .comparison-card-head { display: flex; align-items: center; gap: 11px; padding-bottom: 15px; }
      .comparison-card-number { width: 32px; height: 32px; display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 50%; background: var(--paper-deep); color: var(--ink); font-size: var(--type-label); font-weight: var(--weight-bold); }
      .comparison-card h3 { color: var(--ink); font-family: var(--font-sans); font-size: var(--type-small); font-weight: var(--weight-bold); }
      .comparison-options { display: grid; gap: 9px; }
      .comparison-option { position: relative; min-width: 0; padding: 17px 16px 18px; overflow: hidden; border-radius: var(--radius-sm); }
      .comparison-option::after { content: ""; position: absolute; right: -32px; bottom: -47px; width: 105px; height: 105px; border-radius: 50%; background: currentColor; opacity: 0.06; }
      .comparison-option.steps { border: 1px solid color-mix(in srgb, var(--coral) 28%, white); background: color-mix(in srgb, var(--coral) 13%, var(--canvas)); color: var(--coral-dark); }
      .comparison-option.general { border: 1px solid color-mix(in srgb, var(--sage) 45%, white); background: color-mix(in srgb, var(--sage) 22%, var(--canvas)); color: var(--ink); }
      .comparison-option-label { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; padding: 5px 9px; border-radius: 999px; color: var(--white); font-family: var(--font-sans); font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: 0.06em; }
      .comparison-option.steps .comparison-option-label { background: var(--coral-dark); }
      .comparison-option.general .comparison-option-label { background: var(--ink); }
      .comparison-option strong { position: relative; z-index: 1; display: block; margin-top: 13px; color: currentColor; font-family: var(--font-sans); font-size: var(--type-small); line-height: 1.6; word-break: keep-all; }
      .comparison-option > p:last-child { position: relative; z-index: 1; margin-top: 5px; color: var(--muted); font-family: var(--font-sans); font-size: var(--type-label); line-height: 1.58; word-break: keep-all; }

      .method { overflow: hidden; background: var(--paper); }
      .method-header-row { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
      .method-note { max-width: 380px; color: var(--muted); font-size: var(--type-small); line-height: var(--leading-body); word-break: keep-all; }
      .method-track {
        display: flex;
        gap: 14px;
        margin-right: -16px;
        padding-right: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: 1px;
        overscroll-behavior-inline: contain;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .method-track::-webkit-scrollbar { display: none; }
      .method-card {
        --step: var(--ink);
        --tint: var(--paper-deep);
        position: relative;
        flex: 0 0 min(82vw, 310px);
        min-height: 410px;
        display: flex;
        flex-direction: column;
        padding: 25px 22px;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--step) 23%, white);
        border-radius: var(--radius-md);
        background: var(--white);
        scroll-snap-align: start;
      }
      .method-card::after { content: ""; position: absolute; width: 150px; height: 150px; right: -55px; bottom: -50px; border-radius: 50%; background: var(--tint); }
      .method-card:nth-child(even) { margin-top: 0; }
      .method-number { display: inline-flex; width: 43px; height: 43px; align-items: center; justify-content: center; border-radius: 50%; background: var(--tint); color: var(--step); font-size: var(--type-label); font-weight: var(--weight-bold); }
      .method-verb { margin-top: 36px; color: var(--step); font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: 0.16em; }
      .method-card h3 { margin-top: 5px; color: var(--ink); font-family: var(--font-display); font-size: var(--type-heading); line-height: var(--leading-heading); }
      .method-card p { margin-top: 14px; color: var(--muted); font-size: var(--type-small); line-height: var(--leading-body); word-break: keep-all; }
      .method-promise { position: relative; z-index: 1; margin-top: 16px; padding-top: 14px; border-top: 1px solid color-mix(in srgb, var(--step) 18%, white); }
      .method-promise > span { color: var(--step); font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: var(--tracking-label); }
      .method-promise > p { margin-top: 6px; color: var(--text); font-size: var(--type-label); line-height: 1.65; }
      .method-card small { position: relative; z-index: 1; margin-top: auto; padding-top: 26px; color: var(--step); font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: 0.04em; }
      .swipe-hint { display: flex; align-items: center; gap: 8px; margin-top: 18px; color: var(--muted); font-size: var(--type-label); }
      .swipe-hint::before { content: "←"; color: var(--coral); }

      .class-section { --class-accent: var(--coral-dark); overflow: hidden; background: var(--ink); color: var(--white); }
      .class-section .section-kicker { color: var(--butter); }
      .class-section .section-title { color: var(--white); }
      .class-section .section-copy { color: color-mix(in srgb, var(--white) 68%, transparent); }
      .gallery-grid { display: grid; gap: 20px; }
      .gallery-card { overflow: hidden; border: 1px solid var(--line-dark); border-radius: var(--radius-md); background: var(--canvas); color: var(--text); }
