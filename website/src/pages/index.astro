      .modal-image { width: auto; max-width: 100%; max-height: 68dvh; object-fit: contain; }
      .modal-stage.zoomed .modal-image { width: min(900px, 180vw); max-width: none; max-height: none; }
      .modal-nav { position: absolute; top: 50%; z-index: 2; width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid rgba(23, 52, 47, 0.15); border-radius: 50%; background: rgba(255, 255, 255, 0.92); color: var(--ink); cursor: pointer; transform: translateY(-50%); box-shadow: var(--shadow-sm); }
      .modal-nav:disabled { opacity: 0.3; cursor: default; }
      .modal-nav.prev { left: 8px; }
      .modal-nav.next { right: 8px; }
      .modal-stage.zoomed .modal-nav { display: none; }
      .modal-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 2px 7px; color: var(--muted); font-size: var(--type-label); }
      .modal-counter { color: var(--ink); font-weight: var(--weight-bold); }
      .modal-thumbs { display: flex; gap: 7px; overflow-x: auto; padding: 2px 2px 5px; }
      :global(.modal-thumb) { flex: 0 0 48px; width: 48px; height: 64px; padding: 3px; border: 1px solid var(--line); border-radius: 7px; background: var(--white); cursor: pointer; }
      :global(.modal-thumb[aria-current="true"]) { border-color: var(--class-accent, var(--coral-dark)); box-shadow: 0 0 0 2px color-mix(in srgb, var(--class-accent, var(--coral-dark)) 18%, transparent); }
      :global(.modal-thumb img) { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }


      @media (hover: hover) {
        .button:hover { transform: translateY(-2px); }
        .button-primary:hover { background: #a83f2d; }
        .grade-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--stage) 38%, white); box-shadow: 0 18px 36px rgba(23, 52, 47, 0.11); }
      }

      @media (hover: none) {
        .button:active { transform: scale(0.985); }
      }

      @media (max-width: 599px) {
        .about-positioning, .problem-panel { padding: 24px 20px; }
        .consult-quick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .consult-quick .button { min-width: 0; padding-inline: 11px; font-size: var(--type-body); }
        .notice-row-link { padding: 10px 0 12px; }
        .notice-row-meta { align-items: flex-start; gap: 12px; font-size: var(--type-label); }
        .notice-row-title { margin-top: 5px; font-size: 15px; }
        .notice-row-description { margin-top: 2px; }
        .notice-pagination { gap: 13px; margin-top: 13px; }
      }

      @media (max-width: 759px) {
        .management-grid { gap: 10px; }
        .management-card {
          display: grid;
          grid-template-columns: 43px minmax(0, 1fr);
          grid-template-rows: auto auto;
          column-gap: 14px;
          align-items: center;
          padding: 19px 18px;
        }
        .management-icon { grid-row: 1 / 3; }
        .management-card h3 { margin-top: 0; font-size: var(--type-heading); }
        .management-card p { margin-top: 4px; font-size: var(--type-small); line-height: 1.62; }
      }

      @media (min-width: 600px) {
        .hero-actions { display: flex; flex-wrap: wrap; }
        .hero-actions .button { width: auto; }
        .comparison-options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .stage-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .grade-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }

      @media (min-width: 760px) {
        .hero { padding: 78px 0 50px; }
        .trust-strip { margin-top: 0; }
        .trust-item { padding: 6px 24px; }
        .trust-item strong { font-size: var(--type-heading); }
        .trust-item span { font-size: var(--type-label); }
        .about-story { grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr); align-items: stretch; }
        .about-positioning, .problem-panel { padding: 34px; }
        .comparison-block { margin-top: 24px; }
        .faculty-proof { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .proof-item { border-right: 1px solid rgba(255, 255, 255, 0.23); }
        .proof-item:nth-child(even) { border-right: 0; }
        .proof-item:last-child { grid-column: 1 / -1; border-right: 0; }
        .management-grid { grid-template-columns: repeat(3, 1fr); }
        .method-header-row { flex-direction: row; align-items: flex-end; justify-content: space-between; }
        .method-header-row .section-heading { margin-bottom: 0; }
        .method-track { display: grid; grid-template-columns: repeat(2, 1fr); margin-right: 0; padding-right: 0; overflow: visible; }
        .method-card { min-width: 0; }
        .swipe-hint { display: none; }
        .gallery-stage { min-height: 570px; }
        .gallery-main { max-height: 548px; }
        .weekly-flow { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; }
        .week-card { min-width: 0; }
        .week-card:last-child { grid-column: 1 / -1; }
        .level-hero { grid-template-columns: 1fr auto; align-items: end; }
        .assessment-grid { grid-template-columns: repeat(4, 1fr); }
        .assessment-card { min-height: 220px; }
        .placement-path { display: grid; grid-template-columns: 180px 1fr; align-items: center; gap: 24px; }
        .path-steps { grid-template-columns: repeat(3, 1fr); margin-top: 0; }
        .path-step { grid-template-columns: 37px 1fr; }
        .path-step:not(:last-child)::after { left: auto; right: -6px; top: 50%; bottom: auto; width: 20px; height: 1px; }
        .roadmap { margin-top: 94px; }
        .consult-grid { grid-template-columns: minmax(0, .8fr) minmax(480px, 1.2fr); align-items: start; }
        .consult-form { padding: 32px; }
      }

      @media (min-width: 600px) and (max-width: 859px) {
        .hero-title { font-size: var(--type-hero); }
      }

      @media (min-width: 860px) {
        .hero-grid { grid-template-columns: minmax(0, 1.12fr) minmax(330px, .88fr); align-items: center; gap: 30px; }
        .hero-copy { grid-column: 1; grid-row: 1; }
        .hero-art { grid-column: 2; grid-row: 1; width: 100%; }
        .trust-strip { grid-column: 1 / -1; grid-row: 2; margin-top: 28px; }
        .feedback-note { right: -5%; }
      }

      @media (min-width: 980px) {
        html { scroll-padding-top: calc(80px + env(safe-area-inset-top)); }
        body { padding-bottom: 0; }
        .site-header .header-inner { min-height: 80px; }
        .brand-logo { width: 142px; }
        .hero { min-height: 720px; display: flex; align-items: center; }
        .hero-grid { grid-template-columns: 1.13fr .87fr; gap: 64px; }
        .comparison-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
        .comparison-card { padding: 22px; }
        .method-track { grid-template-columns: repeat(4, 1fr); gap: 16px; }
          .method-card { min-height: 485px; padding: 28px 24px; }
        .method-card:nth-child(even) { margin-top: 38px; }
        .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .weekly-flow { grid-template-columns: repeat(5, minmax(0, 1fr)); }
        .week-card:last-child { grid-column: auto; }
        .faculty-panel { display: grid; grid-template-columns: 1.2fr .8fr; }
        .faculty-main { padding: 58px 54px; }
        .faculty-proof { grid-template-columns: 1fr; border-top: 0; border-left: 1px solid rgba(255, 255, 255, 0.23); }
        .proof-item { grid-template-columns: 46px 1fr; align-content: center; border-right: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.23); }
        .proof-item:last-child { grid-column: auto; border-bottom: 0; }
        .stage-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .stage-card { min-height: 300px; display: flex; flex-direction: column; padding: 25px 22px; }
        .stage-meta { margin-top: auto; padding-top: 28px; }
        .grade-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .grade-description { min-height: 96px; }
        .management-card { min-height: 330px; padding: 30px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
      }
    </style>
  </head>
  <body>
    <SiteChrome homeHref="#top" sectionPrefix="" enableMenuScript={false}>
      <section id="top" class="hero">
        <div class="container">
          <div class="hero-grid">
            <div class="hero-copy">
              <h1 class="hero-title">읽은 책이, 아이의<br /><span class="marker">문장</span>이 되도록.</h1>
              <p class="hero-lead">국제학교 학생과 해외 유학생을 위한 프리미엄 주니어 북클럽</p>
              <p class="hero-detail">국제학교 출신이며 서울대학교에 재학 중인, 원어민급 영어 역량과 최상위 공인성적을 갖춘 검증된 강사진의 4인 소수 관리형 프로그램입니다.</p>
              <div class="hero-credential">
                <span class="hero-credential-seal">
                  <img class="hero-credential-crest" src="/images/credentials/snu-crest.png" width="53" height="55" alt="서울대학교 심볼마크" />
                </span>
                <span class="hero-credential-copy">
                  <small>SNU · 4STEPS FACULTY</small>
                  <strong>국제학교 출신 · 서울대학교 재학 강사진</strong>
                  <span class="hero-credential-meta">원어민급 영어 역량</span>
                </span>
              </div>
              <div class="hero-actions">
                <a class="button button-primary" href="#consulting">무료 레벨테스트 신청 <i data-lucide="arrow-down-right" aria-hidden="true"></i></a>
                <a class="button button-outline" href="#class-content">실제 수업 자료 보기</a>
              </div>
            </div>

            <div class="trust-strip" aria-label="프로그램 핵심 정보">
              <div class="trust-item"><strong>4 : 1</strong><span>최대 4명<br />소그룹</span></div>
              <div class="trust-item"><strong>G1–G9</strong><span>주니어<br />학습 범위</span></div>
              <div class="trust-item"><strong>4 steps</strong><span>읽기에서<br />글쓰기까지</span></div>
            </div>

            <div class="hero-art" role="img" aria-label="책을 읽고 질문과 문장으로 확장하는 4steps 수업을 표현한 일러스트레이션">
              <div class="reading-card">
                <div class="card-meta"><span>THIS WEEK'S READING</span><span>CH. 01–12</span></div>
                <p class="card-book">The Maze<br />Runner</p>
                <p class="card-question">Think beyond the plot.</p>
                <div class="notebook-lines" aria-hidden="true"><span></span><span></span><span></span></div>
                <p class="note-script">“What makes a leader?”</p>
              </div>
              <div class="step-tabs" aria-hidden="true"><span>READ</span><span>THINK</span><span>SPEAK</span><span>WRITE</span></div>
              <div class="feedback-note"><b>TEACHER'S NOTE</b><span>좋은 생각이에요.<br />본문 속 근거를 더해 볼까요?</span></div>
            </div>
          </div>

        </div>
      </section>

      <section id="about" class="section intro">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">Why 4steps</p>
            <h2 class="section-title">좋은 책을 읽는 것만으로는<br />아이의 실력이 완성되지 않습니다.</h2>
          </div>
          <div class="about-story">
            <article class="about-positioning">
              <h3>검증되지 않은 북클럽의 시대를 넘어,<br />확실한 시스템을 선택하세요.</h3>
              <p>기존의 많은 북클럽은 좋은 책을 선정하고 아이들이 자유롭게 이야기하는 방식으로 운영됩니다. 그러나 누가 가르치는지, 무엇을 배우는지, 수업 후 무엇이 남는지는 명확하지 않은 경우가 많습니다.</p>
              <p>4STEPS는 이 문제에서 출발했습니다. 강사진, 수업 구조, 단계별 커리큘럼, 자체 교재, 매주 확인하는 어휘와 글쓰기까지 학부모님이 확인할 수 있는 기준을 만들었습니다.</p>
              <blockquote class="about-quote">“책을 읽었다”에서 끝나지 않고, 아이의 머릿속에 남은 생각이 실제 말과 글로 보이게 합니다.</blockquote>
            </article>
            <aside class="problem-panel" aria-labelledby="problem-title">
              <h3 id="problem-title">기존 북클럽의<br />고민을 해결했습니다.</h3>
              <ul class="problem-list">
                {aboutProblems.map((problem) => <li>{problem}</li>)}
              </ul>
            </aside>
          </div>

          <section class="comparison-block" aria-label="4STEPS BOOK CLUB과 일반 북클럽 비교">
            <div class="comparison-card-grid">
              {comparisonRows.map((row, index) => (
                <article class="comparison-card">
                  <header class="comparison-card-head">
                    <span class="comparison-card-number">{String(index + 1).padStart(2, "0")}</span>
                    <h3>{row.label}</h3>
                  </header>
                  <div class="comparison-options">
                    <section class="comparison-option steps" aria-label={`${row.label}의 4STEPS BOOK CLUB 기준`}>
                      <p class="comparison-option-label">4STEPS BOOK CLUB</p>
                      <strong>{row.steps}</strong>
                      {row.detail && <p>{row.detail}</p>}
                    </section>
                    <section class="comparison-option general" aria-label={`${row.label}의 일반 북클럽 기준`}>
                      <p class="comparison-option-label">일반 북클럽</p>
                      <strong>{row.general}</strong>
                    </section>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>
      </section>

      <section id="method" class="section method">
        <span id="curriculum" class="anchor-target" aria-hidden="true"></span>
        <div class="container">
          <div class="method-header-row">
            <div class="section-heading">
              <p class="section-kicker">The 4steps Method</p>
              <h2 class="section-title">네 번의 움직임으로<br />한 권을 내 것으로</h2>
            </div>
            <p class="method-note">각 단계는 따로 놀지 않습니다. 읽으며 발견한 질문이 토론을 지나 한 편의 글로 이어집니다.</p>
          </div>
          <div class="method-track" aria-label="4steps 학습 과정" tabindex="0">
            {methodSteps.map((step) => (
              <article class="method-card" style={`--step:${step.color};--tint:${step.tint};`}>
                <span class="method-number">{step.number}</span>
                <p class="method-verb">{step.verb}</p>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
                <div class="method-promise">
                  <span>CURRICULUM PROMISE</span>
                  <p>{step.promise}</p>
                </div>
                <small>{step.note}</small>
              </article>
            ))}
          </div>
          <p class="swipe-hint">옆으로 넘겨 4단계를 확인하세요</p>
        </div>
      </section>

      <section id="class-content" class="section class-section">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">Inside the Class</p>
            <h2 class="section-title">설명보다 먼저,<br />실제 수업을 보여드립니다</h2>
            <p class="section-copy">튜터의 질문, 학생의 생각, 실제 교재의 흐름을 한 화면에서 살펴보세요. 페이지를 선택하면 작은 글씨도 크게 볼 수 있습니다.</p>
          </div>

          <AnnotatedEssay />

          <div class="gallery-grid">
            {classContentGalleries.map((gallery) => (
              <article class="gallery-card" data-gallery={gallery.id}>
                <div class="gallery-stage-wrap">
                  <button class="gallery-stage" type="button" data-gallery-open aria-label={`${gallery.label} 첫 페이지 크게 보기`}>
                    <img class="gallery-main" data-gallery-main src={gallery.images[0].preview} alt={gallery.images[0].alt} width="679" height="960" loading="lazy" decoding="async" />
                    <span class="zoom-label"><i data-lucide="maximize-2" aria-hidden="true"></i> 크게 보기</span>
                  </button>
                  <div class="gallery-bar" aria-live="polite" aria-atomic="true">
                    <span data-gallery-caption>{gallery.images[0].caption}</span>
                    <span class="gallery-counter" data-gallery-counter>01 / {String(gallery.images.length).padStart(2, "0")}</span>
                  </div>
                  <div class="gallery-thumbs" role="group" aria-label={`${gallery.label} 페이지 선택`}>
                    {gallery.images.map((image, index) => (
                      <button
                        class="gallery-thumb"
                        type="button"
                        data-gallery-thumb
                        data-index={index}
                        data-full={image.full}
                        data-preview={image.preview}
                        data-thumb={image.thumb}
                        data-caption={image.caption}
                        data-alt={image.alt}
                        aria-current={index === 0 ? "true" : "false"}
                        aria-label={`${index + 1}페이지 보기`}
                      >
                        <img src={image.thumb} alt="" width="54" height="72" loading="lazy" />
                      </button>
                    ))}
                  </div>
                </div>
                <div class="gallery-copy">
                  <span class="gallery-index">{gallery.index} · {gallery.label}</span>
                  <h3>{gallery.title}</h3>
                  <p>{gallery.description}</p>
                  <div class="gallery-tags" aria-label="학습 요소">
                    {gallery.tags.map((tag) => <span class="gallery-tag">{tag}</span>)}
                  </div>
                  <button class="button gallery-open" type="button" data-gallery-open>전체 {gallery.images.length}페이지 보기 <i data-lucide="arrow-up-right" aria-hidden="true"></i></button>
                </div>
              </article>
            ))}
          </div>

          <section class="weekly-panel" aria-labelledby="weekly-title">
            <div class="weekly-head">
              <p>A WEEK AT 4STEPS</p>
              <h3 id="weekly-title">매주 수업은 이렇게 진행됩니다.</h3>
            </div>
            <ol class="weekly-flow" tabindex="0">
              {weeklySteps.map(([number, title, description]) => (
                <li class="week-card"><span>{number}</span><h4>{title}</h4><p>{description}</p></li>
              ))}
            </ol>
          </section>
        </div>
      </section>

      <section id="faculty" class="section faculty-section">
        <div class="container">
          <div class="faculty-panel">
            <div class="faculty-main">
              <p class="section-kicker">Verified Faculty</p>
              <h2>아이의 영어를 맡기는 선생님,<br />4steps는 기준부터 다릅니다</h2>
              <p>4STEPS의 강사진은 단순히 영어를 잘하는 선생님이 아닙니다. 국제학교 출신이면서 서울대학교에 재학 중이고, 원어민 수준의 영어 구사력과 실제 수업 역량을 함께 검증한 선생님만 선별합니다.</p>
              <div class="faculty-credential">
                <img src="/images/credentials/snu-crest.png" width="53" height="55" alt="서울대학교 심볼마크" />
                <span><small>SNU · VERIFIED FACULTY</small><strong>국제학교 출신 · 서울대학교 재학 강사진</strong></span>
              </div>
            </div>
            <div class="faculty-proof" aria-label="강사진 선별 기준">
              {facultyProofs.map((proof, index) => (
                <article class="proof-item"><span class="proof-number">{String(index + 1).padStart(2, "0")}</span><p>{proof}</p></article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="level" class="section level-section">
        <span id="level-system" class="anchor-target" aria-hidden="true"></span>
        <div class="container">
          <div class="level-hero">
            <div class="section-heading">
              <p class="section-kicker">Level Placement</p>
              <h2 class="section-title">학년보다 먼저,<br />지금 읽고 쓰는 방식을 봅니다</h2>
              <p class="section-copy">G1–G9 범위 안에서 현재 학년과 학습 배경을 참고하고, 네 가지 언어 활동을 함께 살펴 시작점을 찾습니다.</p>
            </div>
            <div class="grade-badge" aria-label="Grade 1부터 Grade 9까지"><strong>G1–G9</strong><span>JUNIOR RANGE</span></div>
          </div>

          <div class="assessment-grid" aria-label="레벨 테스트 확인 영역">
            <article class="assessment-card"><span class="assessment-icon"><i data-lucide="book-open" aria-hidden="true"></i></span><span>READING</span><h3>읽기</h3></article>
            <article class="assessment-card"><span class="assessment-icon"><i data-lucide="languages" aria-hidden="true"></i></span><span>VOCABULARY</span><h3>어휘</h3></article>
            <article class="assessment-card"><span class="assessment-icon"><i data-lucide="message-square-text" aria-hidden="true"></i></span><span>DISCUSSION</span><h3>말하기</h3></article>
            <article class="assessment-card"><span class="assessment-icon"><i data-lucide="notebook-pen" aria-hidden="true"></i></span><span>WRITING</span><h3>글쓰기</h3></article>
          </div>

          <div class="placement-path">
            <p>FIND THE RIGHT START</p>
            <div class="path-steps">
              <article class="path-step"><span class="path-dot">1</span><div><h3>기본 정보 접수</h3><p>학년과 학습 배경 확인</p></div></article>
              <article class="path-step"><span class="path-dot">2</span><div><h3>레벨 테스트 안내</h3><p>현재 읽기·쓰기 확인</p></div></article>
              <article class="path-step"><span class="path-dot">3</span><div><h3>시작점 상담</h3><p>학생에게 맞는 수업 안내</p></div></article>
            </div>
          </div>

          <div class="roadmap">
            <div class="roadmap-heading">
              <p class="section-kicker">4steps Level System</p>
              <h2 class="section-title">Level &amp; Roadmap 안내</h2>
              <p class="section-copy">4STEPS의 레벨은 <strong>미국 국제학교 학년 기준 G1–G9</strong>에 맞춰 네 단계로 나뉩니다. 단계별 리딩과 에세이 훈련을 통해 <strong>SAT · AP · IB · A-Level</strong>을 위한 탄탄한 학술적 기초를 완성합니다.</p>
            </div>

            <div class="stage-grid" aria-label="4STEPS 네 단계 로드맵">
              {levelStages.map((stage) => (
                <article class="stage-card" style={`--stage:${stage.color};--stage-tint:${stage.tint};`}>
                  <div class="stage-card-head"><span class="stage-number">{stage.step}</span><span class="stage-grades">{stage.grades}</span></div>
                  <h3>{stage.name}</h3>
                  <p class="stage-focus">{stage.focus}</p>
                  <dl class="stage-meta">
                    <div><dt>중심 학습 내용</dt><dd>{stage.content.join(" · ")}</dd></div>
                  </dl>
                </article>
              ))}
            </div>

            <section class="grade-details" aria-labelledby="grade-details-title">
              <div class="grade-details-head"><h3 id="grade-details-title">G1–G9 단계별 목표</h3><span>NINE LEVELS</span></div>
              <div class="grade-grid">
                {levelGrades.map((grade) => (
                  <article class="grade-card" style={`--stage:${levelStages[grade.stage].color};--stage-tint:${levelStages[grade.stage].tint};`}>
                    <div class="grade-card-head"><strong>{grade.grade}</strong><span>{levelStages[grade.stage].step} · {levelStages[grade.stage].name}</span></div>
                    <p class="grade-description">{grade.description}</p>
                    <dl class="grade-outcomes">
                      <div><dt>말하기</dt><dd>{grade.speaking}</dd></div>
                      <div><dt>쓰기</dt><dd>{grade.writing}</dd></div>
                    </dl>
                  </article>
                ))}
              </div>
            </section>
          </div>
        </div>
      </section>

      <section id="management" class="section management">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">Feedback & Management</p>
            <h2 class="section-title">수업이 끝난 뒤에도<br />성장은 이어지도록</h2>
          </div>
          <div class="management-grid">
            <article class="management-card"><span class="management-icon"><i data-lucide="users-round" aria-hidden="true"></i></span><h3>4인 라이브 수업</h3><p>모든 학생의 읽기, 발언, 질문, 글쓰기를 놓치지 않는 소수 관리형 수업입니다.</p></article>
            <article class="management-card"><span class="management-icon"><i data-lucide="list-checks" aria-hidden="true"></i></span><h3>매주 학습 확인</h3><p>책에서 만난 어휘와 내용 이해를 확인해 읽은 내용을 실제 언어 자산으로 만듭니다.</p></article>
            <article class="management-card"><span class="management-icon"><i data-lucide="file-pen-line" aria-hidden="true"></i></span><h3>에세이 첨삭</h3><p>문법, 표현, 구조와 근거를 살피고 다음 글에서 적용할 구체적인 목표로 연결합니다.</p></article>
          </div>
        </div>
      </section>

      <section id="faq" class="section info-section">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">FAQ</p>
            <h2 class="section-title">부모님이 자주 묻는 질문</h2>
          </div>
          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary><span>{item.question}</span><span class="faq-toggle-icon" aria-hidden="true"></span></summary>
                <p class="faq-answer">{item.answer}</p>
