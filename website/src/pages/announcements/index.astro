---
import { getCollection } from "astro:content";
import NoticeLayout from "../../components/NoticeLayout.astro";
import { formatNoticeDate, sortNotices } from "../../data/notices";

const notices = sortNotices(await getCollection("notices"));
const pageTitle = "공지사항 | 4steps Book Club";
const pageDescription = "4steps Book Club의 새로운 수업 개설과 프로그램 안내를 확인하세요.";
---

<NoticeLayout title={pageTitle} description={pageDescription}>
  <section class="section notices-page" aria-labelledby="notices-page-title">
    <div class="container">
      <div class="section-heading">
        <p class="section-kicker">Notices</p>
        <h1 id="notices-page-title" class="section-title">새로운 수업 소식을<br />확인하세요</h1>
        <p class="section-copy">새로운 반 개설과 프로그램 관련 안내를 이곳에서 전해드립니다.</p>
      </div>

      {notices.length > 0 ? (
        <div class="notice-grid" aria-label="공지사항 목록">
          {notices.map((notice) => (
            <article class="notice-list-card">
              <div>
                <time class="notice-meta" datetime={notice.data.postedAt.toISOString()}>{formatNoticeDate(notice.data.postedAt)}</time>
                <h2>{notice.data.title}</h2>
                <a class="notice-list-link" href={`/announcements/${notice.id}`}>공지 자세히 보기 <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="notice-empty-card">새로운 수업 개설 소식은 이곳에서 안내드립니다.</div>
      )}
    </div>
  </section>
</NoticeLayout>
