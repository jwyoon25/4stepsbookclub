---
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  homeHref?: string;
  sectionPrefix?: string;
  enableMenuScript?: boolean;
}

const {
  homeHref = "/",
  sectionPrefix = "/",
  enableMenuScript = true
} = Astro.props;

const consultingHref = `${sectionPrefix}#consulting`;
---

<a class="skip-link" href="#main-content">본문으로 바로가기</a>
<SiteHeader homeHref={homeHref} sectionPrefix={sectionPrefix} enableMenuScript={enableMenuScript} />

<main id="main-content" tabindex="-1">
  <slot />
</main>

<SiteFooter homeHref={homeHref} sectionPrefix={sectionPrefix} />
<a id="mobile-cta" class="mobile-cta" href={consultingHref}><span>우리 아이의 첫 step 찾기</span><b>무료 레벨테스트</b></a>

<style is:global>
  :root {
    --ink: #17342f;
    --ink-soft: #24483f;
    --paper: #f7f3ea;
    --paper-deep: #eee7da;
    --canvas: #fffdf8;
    --white: #ffffff;
    --coral: #ef6b4a;
    --coral-dark: #b84431;
    --butter: #f2c55c;
    --aqua: #8bc7c3;
    --lilac: #b9abd8;
    --sage: #9dc5a5;
    --stage-surface: #dfe8df;
    --text: #263a34;
    --muted: #5f7069;
    --line: #dfe4dc;
    --line-dark: rgba(255, 255, 255, 0.16);
    --shadow-sm: 0 10px 32px rgba(23, 52, 47, 0.08);
    --shadow-lg: 0 24px 70px rgba(23, 52, 47, 0.15);
    --radius-sm: 14px;
    --radius-md: 22px;
    --radius-lg: 32px;
    --font-display: "Gowun Batang", Georgia, serif;
    --font-sans: "IBM Plex Sans KR", system-ui, sans-serif;
    --weight-regular: 400;
    --weight-semibold: 600;
    --weight-bold: 700;
    --type-hero: clamp(42px, 11.5vw, 72px);
    --type-section: clamp(31px, 8.5vw, 44px);
    --type-heading: 24px;
    --type-body: 16px;
    --type-small: 14px;
    --type-label: 12px;
    --leading-display: 1.34;
    --leading-heading: 1.45;
    --leading-body: 1.75;
    --leading-label: 1.4;
    --tracking-display: -0.045em;
    --tracking-label: 0.12em;
    --container: 1160px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: calc(72px + env(safe-area-inset-top));
    overflow-x: hidden;
    overflow-x: clip;
  }
  body {
    min-width: 320px;
    margin: 0;
    background: var(--canvas);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: var(--type-body);
    line-height: var(--leading-body);
    overflow-x: hidden;
    overflow-x: clip;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
  body.menu-open { overflow: clip; overscroll-behavior: none; }
  img { display: block; max-width: 100%; }
  svg { display: block; }
  a { color: inherit; text-decoration: none; }
  a, button, summary { touch-action: manipulation; -webkit-tap-highlight-color: rgba(23, 52, 47, 0.1); }
  button, input, select, textarea { font: inherit; }
  button { color: inherit; }
  h1, h2, h3, h4, p, ul, ol, blockquote { margin: 0; }
  ul, ol { padding: 0; }
  ::selection { background: var(--butter); color: var(--ink); }
  :focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; box-shadow: 0 0 0 6px var(--butter); }

  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 5000;
    transform: translateY(-160%);
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--white);
    font-weight: var(--weight-bold);
  }
  .skip-link:focus { transform: translateY(0); }
  .container { width: min(var(--container), calc(100% - 32px)); margin-inline: auto; }
  .section { position: relative; padding: 72px 0; }
  .section-heading { max-width: 730px; margin-bottom: 32px; }
  .section-heading.center { margin-inline: auto; text-align: center; }
  .section-heading.center .section-kicker::before { display: none; }
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 16px;
    color: var(--coral-dark);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .section-kicker::before { content: ""; width: 22px; height: 2px; border-radius: 99px; background: currentColor; }
  .section-title {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--type-section);
    font-weight: var(--weight-bold);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    word-break: keep-all;
  }
  .section-copy { margin-top: 15px; color: var(--muted); line-height: 1.75; word-break: keep-all; }
  .button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: var(--type-body);
    font-weight: var(--weight-bold);
    line-height: 1.35;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }
  .button-primary { background: var(--coral-dark); color: var(--white); box-shadow: 0 12px 30px rgba(184, 68, 49, 0.24); }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1200;
    padding-top: env(safe-area-inset-top);
    border-bottom: 1px solid rgba(23, 52, 47, 0.09);
    background: rgba(247, 243, 234, 0.98);
    box-shadow: 0 8px 28px rgba(23, 52, 47, 0.035);
  }
  .site-header .header-inner { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand-home { min-height: 44px; display: inline-flex; flex: 0 0 auto; align-items: center; border-radius: 4px; }
  .brand-logo { display: block; width: 132px; height: auto; transform: translateX(-10.83%); filter: drop-shadow(0 3px 7px rgba(23, 52, 47, 0.06)); }
  .menu-toggle {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(23, 52, 47, 0.15);
    border-radius: 50%;
    background: var(--canvas);
    cursor: pointer;
  }
  .menu-toggle svg { width: 21px; height: 21px; }
  .menu-icon-close { display: none; }
  .menu-toggle[aria-expanded="true"] .menu-icon-open { display: none; }
  .menu-toggle[aria-expanded="true"] .menu-icon-close { display: block; }
  .nav-backdrop {
    position: fixed;
    inset: calc(72px + env(safe-area-inset-top)) 0 0;
    z-index: 1090;
    opacity: 0;
    visibility: hidden;
    background: rgba(14, 36, 31, 0.44);
    transition: opacity 200ms ease, visibility 200ms ease;
  }
  .nav-backdrop.open { opacity: 1; visibility: visible; }
  .site-nav {
    position: fixed;
    top: calc(72px + env(safe-area-inset-top));
    right: 0;
    bottom: 0;
    z-index: 1100;
    width: min(88vw, 390px);
    padding: 22px max(20px, env(safe-area-inset-right)) calc(28px + env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left));
    background: var(--paper);
    transform: translateX(105%);
    visibility: hidden;
    pointer-events: none;
    transition: transform 240ms cubic-bezier(.22,.8,.24,1), visibility 240ms ease;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .site-nav.open { transform: translateX(0); visibility: visible; pointer-events: auto; }
  .nav-label { margin-bottom: 18px; color: var(--muted); font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: 0.15em; }
  .nav-links { display: grid; }
  .nav-links > a:not(.nav-cta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 55px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--type-heading);
    font-weight: var(--weight-bold);
  }
  .nav-links > a:not(.nav-cta)::after { content: "↘"; color: var(--coral); font-family: var(--font-sans); font-size: var(--type-body); }
  .nav-cta { width: 100%; margin-top: 22px; }
  .nav-socials { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7px; margin-top: 22px; }
  .nav-socials .social-chip { width: 100%; min-width: 0; justify-content: center; padding: 0; font-size: var(--type-label); }
  .nav-socials .social-label { display: none; }
  .nav-socials .threads-chip, .footer-socials .threads-chip { background: #111; border-color: #111; color: var(--white); }
  .social-chip {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--canvas);
    color: var(--ink);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }
  .brand-icon { width: 20px; height: 20px; flex: 0 0 auto; border-radius: 50%; object-fit: cover; }
  .social-chip > svg { width: 20px; height: 20px; flex: 0 0 auto; }

  .site-footer {
    position: relative;
    overflow: hidden;
    padding: 52px 0 calc(106px + env(safe-area-inset-bottom));
    background: #102722;
    color: white;
  }
  .site-footer::after { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: var(--coral); }
  .footer-grid, .business-info { position: relative; z-index: 1; }
  .footer-section-label { display: block; color: var(--butter); font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .footer-grid { display: grid; gap: 36px; }
  .footer-brand { display: inline-flex; flex-direction: column; align-items: flex-start; border-radius: 4px; }
  .footer-logo { display: block; width: 305px; max-width: none; height: auto; transform: translateX(-10.83%); filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.16)); }
  .footer-method { margin-top: 13px; color: #a9b5ac; font-size: var(--type-label); font-weight: var(--weight-bold); letter-spacing: 0.18em; }
  .footer-audience { max-width: 390px; margin-top: 13px; color: rgba(255, 255, 255, 0.62); font-size: var(--type-small); font-weight: var(--weight-semibold); line-height: 1.65; word-break: keep-all; }
  .footer-tagline { margin-top: 13px; color: rgba(255, 255, 255, 0.8); font-family: var(--font-display); font-size: var(--type-heading); line-height: var(--leading-heading); }
  .footer-nav-column { min-width: 0; }
  .footer-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; margin-top: 12px; }
  .footer-links a { position: relative; min-height: 44px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.72); font-size: var(--type-small); transition: color 180ms ease, border-color 180ms ease; }
  .footer-links a::after { content: "↗"; color: rgba(239, 107, 74, 0.8); font-size: var(--type-label); opacity: 0; transform: translate(-3px, 3px); transition: opacity 180ms ease, transform 180ms ease; }
  .footer-links a:hover { border-color: rgba(239, 107, 74, 0.55); color: white; }
  .footer-links a:hover::after { opacity: 1; transform: translate(0, 0); }
  .footer-social-block { margin-top: 27px; }
  .footer-socials { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 11px; }
  .footer-socials .social-chip { border-color: rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.07); color: white; transition: background 180ms ease, border-color 180ms ease, transform 180ms ease; }
  .footer-socials .social-chip:hover { border-color: rgba(255, 255, 255, 0.34); background: rgba(255, 255, 255, 0.14); transform: translateY(-2px); }
  .business-info { margin-top: 42px; padding-top: 23px; border-top: 1px solid rgba(255, 255, 255, 0.13); color: rgba(255, 255, 255, 0.64); font-size: var(--type-label); line-height: 1.75; word-break: keep-all; }
  .business-details { display: grid; gap: 8px; margin-top: 12px; }
  .business-details p { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .business-item { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  .business-info strong { color: rgba(255, 255, 255, 0.8); }
  .business-info a { min-height: 32px; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 2px; }
  .copyright { margin-top: 20px; color: rgba(255, 255, 255, 0.48); font-size: var(--type-label); letter-spacing: 0.04em; }

  .mobile-cta {
    position: fixed;
    left: max(10px, env(safe-area-inset-left));
    right: max(10px, env(safe-area-inset-right));
    bottom: calc(10px + env(safe-area-inset-bottom));
    z-index: 1000;
    display: flex;
    width: auto;
    max-width: 440px;
    margin-inline: auto;
    min-height: 54px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 8px 7px 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(23, 52, 47, 0.96);
    color: white;
    box-shadow: 0 14px 34px rgba(23, 52, 47, 0.28);
    backdrop-filter: blur(12px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .mobile-cta.hidden { opacity: 0; transform: translateY(120%); pointer-events: none; }
  .mobile-cta span { font-size: var(--type-label); font-weight: var(--weight-bold); }
  .mobile-cta b { display: inline-flex; min-height: 38px; align-items: center; padding: 7px 14px; border-radius: 999px; background: var(--coral-dark); font-size: var(--type-label); }

  @media (hover: hover) {
    .button:hover { transform: translateY(-2px); }
    .button-primary:hover { background: #a83f2d; }
  }

  @media (min-width: 760px) {
    .container { width: min(var(--container), calc(100% - 64px)); }
    .section { padding: 112px 0; }
    .section-heading { margin-bottom: 52px; }
    .footer-grid { grid-template-columns: minmax(280px, .82fr) minmax(0, 1.18fr); align-items: start; gap: 72px; }
    .footer-links { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .business-info { grid-column: 1 / -1; }
  }

  @media (min-width: 980px) {
    html { scroll-padding-top: calc(80px + env(safe-area-inset-top)); }
    body { padding-bottom: 0; }
    .site-header .header-inner { min-height: 80px; }
    .brand-logo { width: 142px; }
    .menu-toggle, .nav-backdrop, .nav-label { display: none; }
    .site-nav { position: static; width: auto; display: flex; align-items: center; gap: 10px; padding: 0; overflow: visible; background: transparent; transform: none; visibility: visible; pointer-events: auto; }
    .nav-links { display: flex; align-items: center; gap: 17px; }
    .nav-links > a:not(.nav-cta) { min-height: auto; border: 0; font-family: var(--font-sans); font-size: var(--type-small); }
    .nav-links > a:not(.nav-cta)::after { display: none; }
    .nav-links > a:not(.nav-cta):hover { color: var(--coral-dark); }
    .nav-cta { width: auto; min-height: 44px; margin: 0 0 0 4px; padding: 10px 16px; font-size: var(--type-small); }
    .nav-socials { display: flex; gap: 5px; margin: 0; }
    .nav-socials .social-chip { width: 38px; height: 38px; min-height: 38px; justify-content: center; padding: 0; overflow: hidden; border: 0; border-radius: 50%; background: transparent; }
    .nav-socials .social-label { display: none; }
    .nav-socials .brand-icon { display: block; width: 100%; height: 100%; object-fit: cover; }
    .nav-socials .threads-chip { background: #111; color: var(--white); }
    .site-footer { padding-bottom: 42px; }
    .mobile-cta { display: none; }
  }

  @media (min-width: 980px) and (max-width: 1179px) {
    html { scroll-padding-top: calc(72px + env(safe-area-inset-top)); }
    .site-header .header-inner { min-height: 72px; }
    .menu-toggle { display: inline-flex; }
    .nav-backdrop { display: block; }
    .nav-label { display: block; }
    .site-nav {
      position: fixed;
      top: calc(72px + env(safe-area-inset-top));
      right: 0;
      bottom: 0;
      width: min(88vw, 390px);
      display: block;
      padding: 22px max(20px, env(safe-area-inset-right)) calc(28px + env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left));
      overflow-y: auto;
      background: var(--paper);
      transform: translateX(105%);
      visibility: hidden;
      pointer-events: none;
    }
    .site-nav.open { transform: translateX(0); visibility: visible; pointer-events: auto; }
    .nav-links { display: grid; gap: 0; }
    .nav-links > a:not(.nav-cta) { min-height: 55px; border-bottom: 1px solid var(--line); font-family: var(--font-display); font-size: var(--type-heading); }
    .nav-links > a:not(.nav-cta)::after { display: inline; }
    .nav-cta { width: 100%; min-height: 52px; margin: 22px 0 0; padding: 13px 20px; font-size: var(--type-body); }
    .nav-socials { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7px; margin: 22px 0 0; }
    .nav-socials .social-chip { width: 100%; height: auto; min-height: 44px; padding: 0; border: 1px solid var(--line); border-radius: 999px; background: var(--canvas); }
    .nav-socials .brand-icon { width: 20px; height: 20px; }
  }

  @media (max-width: 1179px) {
    .site-header { position: fixed; left: 0; right: 0; }
    #main-content { padding-top: calc(72px + env(safe-area-inset-top)); }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
  }
</style>
