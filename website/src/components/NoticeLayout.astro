---
import SiteChrome from "./SiteChrome.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(image || "/images/og/og-default.png", Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ea" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="4steps Book Club" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/images/logo/logomark-small-dark.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/icons/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/images/icons/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/icons/favicon-192.png" />
    <link rel="shortcut icon" href="/images/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@700&family=IBM+Plex+Sans+KR:wght@400;600;700&display=swap" rel="stylesheet" />
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/lucide@0.468.0/dist/umd/lucide.min.js"></script>
  </head>
  <body>
    <SiteChrome homeHref="/" sectionPrefix="/">
      <slot />
    </SiteChrome>
  </body>
</html>

<style is:global>
  .notices-page { background: var(--canvas); }
  .notice-grid { display: grid; gap: 16px; }
  .notice-list-card { display: grid; gap: 20px; padding: 21px; border: 1px solid var(--line); border-radius: var(--radius-md); background: white; box-shadow: 0 15px 40px rgba(23, 52, 47, 0.05); }
  .notice-list-media { aspect-ratio: 16 / 8; overflow: hidden; border-radius: var(--radius-sm); background: var(--paper); }
  .notice-list-media img { width: 100%; height: 100%; object-fit: cover; }
  .notice-meta { display: block; color: var(--muted); font-size: var(--type-label); font-weight: var(--weight-bold); }
  .notice-list-card h2 { margin-top: 6px; color: var(--ink); font-family: var(--font-display); font-size: clamp(21px, 4vw, 28px); line-height: 1.45; word-break: keep-all; }
  .notice-list-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; color: var(--coral-dark); font-size: var(--type-small); font-weight: var(--weight-bold); }
  .notice-list-link:hover { color: var(--coral); }
  .notice-empty-card { padding: 28px 22px; border-radius: var(--radius-md); background: var(--butter); color: var(--ink); }

  .notice-detail { background: var(--canvas); }
  .notice-detail-back { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: var(--type-small); font-weight: var(--weight-bold); }
  .notice-detail-back:hover { color: var(--coral-dark); }
  .notice-detail-header { margin-top: 30px; padding-bottom: 27px; border-bottom: 1px solid var(--line); }
  .notice-detail-title { margin-top: 9px; color: var(--ink); font-family: var(--font-display); font-size: clamp(32px, 7vw, 54px); font-weight: var(--weight-bold); line-height: 1.4; letter-spacing: var(--tracking-display); word-break: keep-all; }
  .notice-detail-body { max-width: 760px; padding-top: 29px; color: var(--text); font-size: var(--type-body); line-height: 1.9; word-break: keep-all; }
  .notice-detail-body p + p { margin-top: 17px; }
  .notice-detail-body h2, .notice-detail-body h3 { margin-top: 30px; margin-bottom: 10px; color: var(--ink); font-family: var(--font-display); line-height: 1.5; }
  .notice-detail-body ul, .notice-detail-body ol { margin-top: 12px; padding-left: 20px; }
  .notice-detail-body a { color: var(--coral-dark); text-decoration: underline; text-underline-offset: 3px; }
  .notice-detail-images { display: grid; gap: 14px; margin-top: 34px; }
  .notice-detail-images img { width: 100%; height: auto; border-radius: var(--radius-sm); background: var(--paper); }

  @media (min-width: 760px) {
    .notice-list-card { grid-template-columns: minmax(220px, 0.62fr) minmax(0, 1fr); align-items: center; padding: 25px; }
    .notice-list-media { height: 180px; aspect-ratio: auto; }
  }
</style>
