---
interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(image || "/images/og/og-default.png", Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ea" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="4steps Book Club" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/images/logo/logomark-small-dark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@700&family=IBM+Plex+Sans+KR:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="notice-site-header">
      <div class="notice-container notice-header-inner">
        <a class="notice-brand" href="/" aria-label="4steps Book Club 홈">
          <img src="/images/logo/logomark-small-dark.svg" alt="" width="42" height="42" />
          <span><strong>4STEPS</strong><small>BOOK CLUB</small></span>
        </a>
        <a class="notice-back-link" href="/">홈으로 돌아가기 <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main>
      <div class="notice-container">
        <slot />
      </div>
    </main>

    <footer class="notice-site-footer">
      <div class="notice-container notice-footer-inner">
        <span>© 2026 4STEPS BOOK CLUB</span>
        <a href="/#notices">공지사항</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --notice-ink: #17342f;
    --notice-paper: #f7f3ea;
    --notice-canvas: #fffdf8;
    --notice-coral: #b84431;
    --notice-butter: #f2c55c;
    --notice-muted: #5f7069;
    --notice-line: #dfe4dc;
    --notice-display: "Gowun Batang", Georgia, serif;
    --notice-sans: "IBM Plex Sans KR", system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--notice-canvas); }
  body {
    min-width: 320px;
    margin: 0;
    background: var(--notice-canvas);
    color: var(--notice-ink);
    font-family: var(--notice-sans);
    font-size: 16px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  h1, h2, h3, p, ul, ol { margin: 0; }
  ul, ol { padding-left: 20px; }
  :focus-visible { outline: 3px solid var(--notice-ink); outline-offset: 3px; box-shadow: 0 0 0 6px var(--notice-butter); }
  .notice-container { width: min(900px, calc(100% - 32px)); margin-inline: auto; }
  .notice-site-header { border-bottom: 1px solid rgba(23, 52, 47, 0.1); background: rgba(247, 243, 234, 0.96); }
  .notice-header-inner { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .notice-brand { display: inline-flex; align-items: center; gap: 10px; }
  .notice-brand img { width: 36px; height: 36px; }
  .notice-brand span { display: grid; line-height: 1.1; }
  .notice-brand strong { font-size: 14px; letter-spacing: 0.14em; }
  .notice-brand small { margin-top: 4px; color: var(--notice-muted); font-size: 9px; font-weight: 700; letter-spacing: 0.2em; }
  .notice-back-link { color: var(--notice-muted); font-size: 13px; font-weight: 700; }
  .notice-back-link:hover, .notice-list-link:hover { color: var(--notice-coral); }
  .notice-page-intro { padding: 68px 0 35px; }
  .notice-eyebrow { color: var(--notice-coral); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; }
  .notice-page-title { margin-top: 15px; font-family: var(--notice-display); font-size: clamp(34px, 7vw, 56px); line-height: 1.35; letter-spacing: -0.05em; }
  .notice-page-lead { max-width: 620px; margin-top: 17px; color: var(--notice-muted); font-size: 15px; line-height: 1.8; word-break: keep-all; }
  .notice-grid { display: grid; gap: 16px; padding-bottom: 82px; }
  .notice-list-card { display: grid; gap: 20px; padding: 21px; border: 1px solid var(--notice-line); border-radius: 22px; background: white; box-shadow: 0 15px 40px rgba(23, 52, 47, 0.05); }
  .notice-list-media { aspect-ratio: 16 / 8; overflow: hidden; border-radius: 14px; background: var(--notice-paper); }
  .notice-list-media img { width: 100%; height: 100%; object-fit: cover; }
  .notice-meta { display: block; color: var(--notice-muted); font-size: 12px; font-weight: 700; }
  .notice-list-card h2 { margin-top: 6px; font-family: var(--notice-display); font-size: clamp(21px, 4vw, 28px); line-height: 1.45; }
  .notice-list-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; color: var(--notice-coral); font-size: 13px; font-weight: 700; }
  .notice-empty-card { padding: 28px 22px; border-radius: 22px; background: var(--notice-butter); color: var(--notice-ink); }
  .notice-detail { padding: 68px 0 88px; }
  .notice-detail-back { display: inline-flex; align-items: center; gap: 7px; color: var(--notice-muted); font-size: 13px; font-weight: 700; }
  .notice-detail-back:hover { color: var(--notice-coral); }
  .notice-detail-header { margin-top: 30px; padding-bottom: 27px; border-bottom: 1px solid var(--notice-line); }
  .notice-detail-title { margin-top: 9px; font-family: var(--notice-display); font-size: clamp(32px, 7vw, 54px); line-height: 1.4; letter-spacing: -0.05em; word-break: keep-all; }
  .notice-detail-body { max-width: 760px; padding-top: 29px; color: #263a34; font-size: 16px; line-height: 1.9; word-break: keep-all; }
  .notice-detail-body p + p { margin-top: 17px; }
  .notice-detail-body h2, .notice-detail-body h3 { margin-top: 30px; margin-bottom: 10px; font-family: var(--notice-display); line-height: 1.5; }
  .notice-detail-body ul, .notice-detail-body ol { margin-top: 12px; }
  .notice-detail-body a { color: var(--notice-coral); text-decoration: underline; text-underline-offset: 3px; }
  .notice-detail-images { display: grid; gap: 14px; margin-top: 34px; }
  .notice-detail-images img { width: 100%; height: auto; border-radius: 16px; background: var(--notice-paper); }
  .notice-site-footer { border-top: 1px solid var(--notice-line); background: var(--notice-paper); }
  .notice-footer-inner { min-height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--notice-muted); font-size: 12px; font-weight: 700; }
  .notice-footer-inner a { color: var(--notice-ink); }

  @media (min-width: 700px) {
    .notice-container { width: min(900px, calc(100% - 64px)); }
    .notice-page-intro { padding-top: 94px; }
    .notice-list-card { grid-template-columns: minmax(220px, 0.62fr) minmax(0, 1fr); align-items: center; padding: 25px; }
    .notice-list-media { height: 180px; aspect-ratio: auto; }
    .notice-detail { padding-top: 94px; }
  }
</style>
